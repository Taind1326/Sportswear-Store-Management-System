@model Do_an.ViewModels.ThongBaoWebsitePopupViewModel

@if (Model != null && Model.ThongBao != null)
{
    var thongBao = Model.ThongBao;

    <div class="modal fade sportix-promotion"
         id="sportixPromotion"
         tabindex="-1"
         aria-labelledby="promotionTitle"
         aria-describedby="promotionContent"
         aria-hidden="true"
         data-notice-id="@thongBao.MaThongBaoWebsite"
         data-account-id="@Model.MaTaiKhoan">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content promotion-card">
                <button type="button"
                        class="promotion-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng thông báo">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>

                <div class="modal-body promotion-body">
                    <span class="promotion-tag">SPORTIX SALE</span>

                    <h2 class="promotion-title" id="promotionTitle">
                        @thongBao.TieuDe
                    </h2>

                    @if (Model.CoHaiCot)
                    {
                        <div class="promotion-offers">
                            <div class="promotion-offer">
                                <span class="promotion-label">
                                    @thongBao.NhanTrai
                                </span>
                                <strong class="promotion-value">
                                    @thongBao.GiaTriTrai
                                </strong>
                                <span class="promotion-note">
                                    @thongBao.MoTaTrai
                                </span>
                            </div>

                            <div class="promotion-offer">
                                <span class="promotion-label">
                                    @thongBao.NhanPhai
                                </span>
                                <strong class="promotion-value">
                                    @thongBao.GiaTriPhai
                                </strong>
                                <span class="promotion-note">
                                    @thongBao.MoTaPhai
                                </span>
                            </div>
                        </div>
                    }

                    <p class="promotion-content" id="promotionContent">@thongBao.NoiDung</p>

                    <a href="@Url.Action("Index", "ThongBaoWebsite", new { area = "" })"
                       class="promotion-button">
                        Xem ưu đãi ngay
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>

                    @if (Model.MaTaiKhoan.HasValue)
                    {
                        using (Html.BeginForm(
                            "DaXem",
                            "ThongBaoWebsite",
                            new { area = "" },
                            FormMethod.Post,
                            new { @class = "promotion-seen-form", hidden = "hidden" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="id"
                                   value="@thongBao.MaThongBaoWebsite" />
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}