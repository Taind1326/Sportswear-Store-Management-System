@{
    var controller = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var action = Convert.ToString(ViewContext.RouteData.Values["action"]);

    bool daDangNhap = Session["MaTaiKhoan"] != null;
    string hoTen = Convert.ToString(Session["HoTen"]);
    string vaiTro = Convert.ToString(Session["VaiTro"]);
    bool laAdmin = vaiTro == "Admin";

    string chuCai = "?";
    if (!string.IsNullOrWhiteSpace(hoTen))
    {
        string[] tu = hoTen.Trim().Split(' ');
        chuCai = tu[tu.Length - 1].Substring(0, 1).ToUpper();
    }
}

<nav class="sz-navbar navbar navbar-expand-md sticky-top"
     aria-label="Điều hướng chính">
    <div class="container">
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="navbar-brand sz-brand">
            <span class="sz-logo-box">
                <img src="@Url.Content("~/Content/sportix/img/logo.jpg")"
                     class="sz-logo"
                     alt="SPORTIX" />
            </span>
        </a>

        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navMenu"
                aria-controls="navMenu"
                aria-expanded="false"
                aria-label="Đóng hoặc mở menu">
            <i class="bi bi-list fs-3" aria-hidden="true"></i>
        </button>

        <div class="collapse navbar-collapse justify-content-end"
             id="navMenu">
            <ul class="navbar-nav gap-1 align-items-md-center mt-3 mt-md-0">
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home", new { area = "" })"
                       class="nav-link sz-nav-link @(controller == "Home" && action == "Index" ? "active" : "")">
                        Trang chủ
                    </a>
                </li>

                <li class="nav-item">
                    <a href="@Url.Action("Index", "SanPham", new { area = "" })"
                       class="nav-link sz-nav-link @(controller == "SanPham" ? "active" : "")">
                        Sản phẩm
                    </a>
                </li>

                <li class="nav-item">
                    <a href="@Url.Action("GioiThieu", "Home", new { area = "" })"
                       class="nav-link sz-nav-link @(controller == "Home" && action == "GioiThieu" ? "active" : "")">
                        Giới thiệu
                    </a>
                </li>

                @if (!laAdmin)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("LienHe", "Home", new { area = "" })"
                           class="nav-link sz-nav-link @(controller == "Home" && action == "LienHe" ? "active" : "")">
                            Liên hệ
                        </a>
                    </li>
                }

                @if (!daDangNhap)
                {
                    <li class="nav-item ms-md-2">
                        <a href="@Url.Action("DangNhap", "TaiKhoan", new { area = "" })"
                           class="btn sz-nav-btn">
                            Đăng nhập
                        </a>
                    </li>
                }
                else
                {
                    if (vaiTro == "User")
                    {
                        <li class="nav-item text-center">
                            <a href="@Url.Action("Index", "GioHang", new { area = "" })"
                               class="btn btn-primary bg-gradient position-relative rounded-3 shadow-sm d-inline-flex align-items-center justify-content-center p-2"
                               title="Giỏ hàng">
                                <i class="bi bi-cart3 fs-4 lh-1" aria-hidden="true"></i>
                                <span class="visually-hidden">Giỏ hàng, </span>
                                <span class="position-absolute top-0 end-0 badge rounded-pill bg-danger border border-white px-1 py-0"
                                      style="min-width: 1rem; font-size: .625rem; line-height: .875rem; transform: translateX(25%);">
                                    @Html.Action("SoLuongHienTai", "GioHang", new { area = "" })
                                </span>
                                <span class="visually-hidden"> sản phẩm</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown sz-account ms-md-2">
                        <button type="button"
                                id="szAccountToggle"
                                class="sz-user-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="sz-avatar" aria-hidden="true">@chuCai</span>
                            <span class="sz-user-name">@(string.IsNullOrWhiteSpace(hoTen) ? "Tài khoản" : hoTen)</span>
                            <i class="bi bi-chevron-down sz-user-chevron" aria-hidden="true"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end sz-account-menu"
                            aria-labelledby="szAccountToggle">
                            @if (!string.IsNullOrWhiteSpace(hoTen))
                            {
                                <li class="sz-account-name">@hoTen</li>
                            }

                            <li>
                                <a class="dropdown-item"
                                   href="@Url.Action("HoSo", "TaiKhoan", new { area = "" })">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    @(laAdmin ? "Hồ sơ của tôi" : "Hồ sơ")
                                </a>
                            </li>
                            @if (vaiTro == "User")
                            {
                                <li>
                                    <a class="dropdown-item"
                                       href="@Url.Action("DiaChi", "TaiKhoan", new { area = "" })">
                                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                        Địa chỉ
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       href="@Url.Action("Index", "DonHang", new { area = "" })">
                                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                                        Đơn hàng của tôi
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @using (Html.BeginForm("DangXuat", "TaiKhoan", new { area = "" },
                                    FormMethod.Post, new { @class = "m-0" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item sz-account-logout">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                        Đăng xuất
                                    </button>
                                }
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>