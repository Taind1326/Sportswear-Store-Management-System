<div id="chatAi" class="chat-ai"
     data-url="@Url.Action("Chat", "TroLyAI", new { area = "" })">

    <button type="button" id="chatAiNut" class="chat-ai-nut"
            aria-label="Mở trợ lý AI" aria-expanded="false" aria-controls="chatAiKhung">
        <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
    </button>

    <section id="chatAiKhung" class="chat-ai-khung" hidden aria-label="Trợ lý AI SPORTIX">
        <header class="chat-ai-dau" id="chatAiDau">
            <div class="chat-ai-tieude">
                <strong>Trợ lý SPORTIX</strong>
                <span>Tư vấn sản phẩm, giá, size</span>
            </div>
            <div class="chat-ai-dieukhien">
                <button type="button" id="chatAiThuNho" aria-label="Thu nhỏ">
                    <i class="bi bi-dash-lg" aria-hidden="true"></i>
                </button>
                <button type="button" id="chatAiDong" aria-label="Đóng">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <div class="chat-ai-than" id="chatAiThan">
            <div id="chatAiTinNhan" class="chat-ai-tinnhan" role="log" aria-live="polite"></div>
            <div id="chatAiGoiY" class="chat-ai-goiy"></div>

            <form id="chatAiForm" class="chat-ai-form" autocomplete="off">
                <input id="chatAiO" type="text" maxlength="500"
                       placeholder="Nhập câu hỏi..." aria-label="Câu hỏi của bạn" />
                <button type="submit" id="chatAiGui" aria-label="Gửi">
                    <i class="bi bi-send-fill" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    </section>
</div>

<style>
    .chat-ai [hidden] {
        display: none !important;
    }

    .chat-ai-nut {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 1040;
        width: 56px;
        height: 56px;
        border: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--blue), var(--lime));
        color: #fff;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 28px rgba(17, 157, 255, .45);
        cursor: pointer;
    }

    .chat-ai-khung {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 1041;
        width: min(380px, calc(100vw - 24px));
        height: min(560px, calc(100vh - 32px));
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 48px rgba(15, 23, 42, .22);
    }

        .chat-ai-khung.thu-nho {
            height: auto;
        }

            .chat-ai-khung.thu-nho .chat-ai-than {
                display: none;
            }

    .chat-ai-dau {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 14px;
        background: linear-gradient(90deg, var(--blue), var(--blue-dark));
        color: #fff;
    }

    .chat-ai-tieude {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

        .chat-ai-tieude span {
            font-size: .78rem;
            opacity: .9;
        }

    .chat-ai-dieukhien {
        display: flex;
        gap: 4px;
    }

        .chat-ai-dieukhien button {
            width: 32px;
            height: 32px;
            border: 0;
            border-radius: 8px;
            background: rgba(255, 255, 255, .18);
            color: #fff;
            cursor: pointer;
        }

            .chat-ai-dieukhien button:hover {
                background: rgba(255, 255, 255, .32);
            }

    .chat-ai-than {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .chat-ai-tinnhan {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: var(--blue-soft);
    }

    .chat-ai-tin {
        max-width: 85%;
        padding: 9px 12px;
        border-radius: 14px;
        font-size: .92rem;
        line-height: 1.45;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .chat-ai-tin-user {
        align-self: flex-end;
        background: var(--blue);
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .chat-ai-tin-bot {
        align-self: flex-start;
        background: #fff;
        color: var(--text);
        border: 1px solid var(--border);
        border-bottom-left-radius: 4px;
    }

    .chat-ai-tin-cho {
        color: var(--muted);
        font-style: italic;
    }

    .chat-ai-tin-loi {
        border-color: #f1aeb5;
        background: #fff5f5;
    }

    .chat-ai-goiy {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 8px 12px 0;
        background: #fff;
    }

        .chat-ai-goiy button {
            border: 1px solid var(--border);
            background: #fff;
            color: var(--blue-dark);
            border-radius: 999px;
            padding: 4px 10px;
            font-size: .8rem;
            cursor: pointer;
        }

            .chat-ai-goiy button:hover {
                background: var(--blue-soft);
            }

    .chat-ai-form {
        display: flex;
        gap: 8px;
        padding: 10px 12px 12px;
        background: #fff;
    }

        .chat-ai-form input {
            flex: 1;
            min-width: 0;
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 9px 14px;
            font-size: .92rem;
        }

            .chat-ai-form input:focus {
                outline: 2px solid var(--blue);
                border-color: transparent;
            }

        .chat-ai-form button {
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 50%;
            background: var(--blue);
            color: #fff;
            cursor: pointer;
        }

            .chat-ai-form button:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

    @@media (max-width: 575.98px) {
        .chat-ai-khung {
            right: 8px;
            left: 8px;
            bottom: 8px;
            width: auto;
            height: min(70vh, calc(100vh - 16px));
        }
    }
</style>

<script>
    (function () {
        var goc = document.getElementById("chatAi");
        if (!goc) return;

        var url = goc.getAttribute("data-url");
        var nut = document.getElementById("chatAiNut");
        var khung = document.getElementById("chatAiKhung");
        var dau = document.getElementById("chatAiDau");
        var hop = document.getElementById("chatAiTinNhan");
        var goiY = document.getElementById("chatAiGoiY");
        var form = document.getElementById("chatAiForm");
        var o = document.getElementById("chatAiO");
        var nutGui = document.getElementById("chatAiGui");

        var lichSu = [];
        var dangGui = false;
        var daChao = false;

        var cauGoiY = [
            "Giày chạy bộ dưới 2 triệu",
            "Áo thể thao size M còn hàng không?",
            "Gợi ý phụ kiện dưới 500k"
        ];

        function themTin(noiDung, lop) {
            var d = document.createElement("div");
            d.className = "chat-ai-tin chat-ai-tin-" + lop.split(" ").join(" chat-ai-tin-");
            d.textContent = noiDung; // textContent: không chèn HTML, tránh XSS
            hop.appendChild(d);
            hop.scrollTop = hop.scrollHeight;
            return d;
        }

        function mo() {
            khung.hidden = false;
            khung.classList.remove("thu-nho");
            nut.hidden = true;
            nut.setAttribute("aria-expanded", "true");

            if (!daChao) {
                daChao = true;
                themTin("Xin chào! Mình là trợ lý SPORTIX. Bạn cần tư vấn sản phẩm, giá, size hay màu nào?", "bot");
                cauGoiY.forEach(function (c) {
                    var b = document.createElement("button");
                    b.type = "button";
                    b.textContent = c;
                    b.addEventListener("click", function () { gui(c); });
                    goiY.appendChild(b);
                });
            }

            o.focus();
        }

        function dong() {
            khung.hidden = true;
            nut.hidden = false;
            nut.setAttribute("aria-expanded", "false");
            nut.focus();
        }

        function thuNho() {
            khung.classList.add("thu-nho");
        }

        function gui(cauHoi) {
            cauHoi = (cauHoi || "").trim();
            if (!cauHoi || dangGui) return;

            dangGui = true;
            nutGui.disabled = true;
            goiY.hidden = true;
            o.value = "";

            themTin(cauHoi, "user");
            var cho = themTin("Đang trả lời...", "bot cho");

            fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ cauHoi: cauHoi, lichSu: lichSu.slice(-6) })
            })
            .then(function (r) {
                return r.json().catch(function () { return null; });
            })
            .then(function (d) {
                cho.remove();

                if (d && d.NoiDung) {
                    var text = String(d.NoiDung).replace(/\*\*/g, "");
                    themTin(text, d.ThanhCong ? "bot" : "bot loi");

                    if (d.ThanhCong) {
                        lichSu.push({ role: "user", text: cauHoi });
                        lichSu.push({ role: "model", text: text });
                    }
                } else {
                    themTin("Xin lỗi, hiện chưa thể trả lời. Bạn vui lòng thử lại sau nhé.", "bot loi");
                }
            })
            .catch(function () {
                cho.remove();
                themTin("Không kết nối được. Bạn kiểm tra mạng rồi thử lại nhé.", "bot loi");
            })
            .then(function () {
                dangGui = false;
                nutGui.disabled = false;
                o.focus();
            });
        }

        nut.addEventListener("click", mo);
        document.getElementById("chatAiDong").addEventListener("click", dong);
        document.getElementById("chatAiThuNho").addEventListener("click", thuNho);

        dau.addEventListener("click", function (e) {
            if (khung.classList.contains("thu-nho") && !e.target.closest(".chat-ai-dieukhien")) {
                khung.classList.remove("thu-nho");
                o.focus();
            }
        });

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            gui(o.value);
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !khung.hidden) dong();
        });
    })();
</script>