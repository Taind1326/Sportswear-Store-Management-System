<footer class="sz-footer">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-4">
                <h2 class="sz-footer-brand">SPORTIX</h2>

                <p class="sz-footer-slogan">
                    Move faster. Train better.
                    Khám phá giày, trang phục và phụ kiện thể thao
                    phù hợp với phong cách của bạn.
                </p>
            </div>

            <div class="col-6 col-lg-2">
                <h3 class="sz-footer-title">Mua sắm</h3>

                @Html.Action(
                    "DanhMucFooter",
                    "Home",
                    new { area = "" })
            </div>

            <div class="col-6 col-lg-2">
                <h3 class="sz-footer-title">Khám phá</h3>

                <ul class="sz-footer-links">
                    <li>
                        <a href="@Url.Action("Index", "Home", new { area = "" })">
                            Trang chủ
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "SanPham", new { area = "" })">
                            Sản phẩm
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("GioiThieu", "Home", new { area = "" })">
                            Giới thiệu
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("LienHe", "Home", new { area = "" })">
                            Liên hệ
                        </a>
                    </li>
                </ul>
            </div>

            <div class="col-12 col-lg-4">
                <h3 class="sz-footer-title">Liên hệ</h3>

                <ul class="sz-footer-contact">
                    <li>
                        <i class="bi bi-geo-alt-fill"
                           aria-hidden="true"></i>

                        <a href="https://www.google.com/maps/search/?api=1&query=140+Le+Trong+Tan+Tay+Thanh+Ho+Chi+Minh"
                           target="_blank"
                           rel="noopener noreferrer">
                            140 Lê Trọng Tấn, Tây Thạnh,
                            Thành phố Hồ Chí Minh
                        </a>
                    </li>
                    <li>
                        <i class="bi bi-telephone-fill"
                           aria-hidden="true"></i>

                        <a href="tel:19001234">1900 1234</a>
                    </li>
                    <li>
                        <i class="bi bi-send-fill"
                           aria-hidden="true"></i>

                        <a href="mailto:hotro@sportix.vn">
                            hotro@sportix.vn
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="sz-footer-bottom">
        <div class="container">
            <p class="sz-footer-copyright">
                <span>
                    Copyright &copy; @DateTime.Now.Year SPORTIX.
                </span>

                <span class="sz-footer-divider" aria-hidden="true">
                    |
                </span>

                <span class="sz-footer-policies">
                    <a href="@Url.Action("ChinhSachBaoMat", "Home", new { area = "" })">
                        Chính sách bảo mật
                    </a>

                    <span aria-hidden="true">·</span>

                    <a href="@Url.Action("DieuKhoanDichVu", "Home", new { area = "" })">
                        Điều khoản dịch vụ
                    </a>
                </span>
            </p>
        </div>
    </div>
</footer>