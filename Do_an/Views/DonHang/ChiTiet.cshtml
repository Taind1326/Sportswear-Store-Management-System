@model Do_an.ViewModels.ChiTietDonHangViewModel
@using Do_an.Services

@{
    var d = Model.Don;
    ViewBag.Title = "Đơn hàng #" + d.MaDonHang;
}

<div class="container py-4">
    <a href="@Url.Action("Index", "DonHang", new { area = "" })">&larr; Đơn hàng của tôi</a>
    <h1 class="h3 my-3">
        Đơn hàng #@d.MaDonHang
        <span class="badge @TrangThaiDonHang.LopBadge(d.TrangThai) ms-2">@TrangThaiDonHang.Ten(d.TrangThai)</span>
    </h1>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["ThanhCong"]</div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Loi"]</div>
    }

    <div class="table-responsive mb-3">
        <table class="table align-middle">
            <thead><tr><th>Sản phẩm</th><th>Size / Màu</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var x in Model.Dong)
                {
                    <tr>
                        <td>@x.TenSanPham</td>
                        <td>@x.KichThuoc / @x.MauSac</td>
                        <td class="text-end">@x.SoLuong</td>
                        <td class="text-end">@x.DonGia.ToString("N0")đ</td>
                        <td class="text-end">@((x.ThanhTien ?? x.DonGia * x.SoLuong).ToString("N0"))đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <h2 class="h6">Giao tới</h2>
            <p class="mb-0">@d.HoTenNguoiNhan · @d.SoDienThoai<br />@d.DiaChiCuThe, @d.PhuongXa, @d.TinhThanh</p>
            @if (d.TrangThai == TrangThaiDonHang.DaHuy)
            {
                <p class="mt-2 mb-0"><strong>Lý do hủy:</strong> @d.LyDoHuy</p>
            }
            @foreach (var t in Model.ThanhToans)
            {
                <p class="mt-2 mb-0">Thanh toán @t.PhuongThuc: @TrangThaiThanhToan.Ten(t.TrangThai)</p>
            }
        </div>
        <div class="col-md-6">
            <dl class="row mb-0">
                <dt class="col-6">Tiền hàng</dt><dd class="col-6 text-end">@d.TienHang.ToString("N0")đ</dd>
                <dt class="col-6">Giảm giá</dt><dd class="col-6 text-end">-@d.TienGiam.ToString("N0")đ</dd>
                <dt class="col-6">Phí vận chuyển</dt><dd class="col-6 text-end">@d.PhiVanChuyen.ToString("N0")đ</dd>
                <dt class="col-6">Tổng thanh toán</dt><dd class="col-6 text-end fw-bold">@((d.TongTien ?? 0).ToString("N0"))đ</dd>
            </dl>
        </div>
    </div>

    @* Khách chỉ được hủy khi Chờ xác nhận *@
    @if (d.TrangThai == TrangThaiDonHang.ChoXacNhan)
    {
        using (Html.BeginForm("Huy", "DonHang", new { area = "" }, FormMethod.Post,
            new { @class = "mt-4", onsubmit = "return confirm('Bạn chắc chắn muốn hủy đơn này?');" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@d.MaDonHang" />
            <label for="lyDo" class="form-label">Lý do hủy (tuỳ chọn)</label>
            <textarea id="lyDo" name="lyDo" class="form-control mb-2" rows="2" maxlength="500"></textarea>
            <button type="submit" class="btn btn-outline-danger">Hủy đơn</button>
        }
    }
</div>
