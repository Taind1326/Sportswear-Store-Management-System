
@model Do_an.Models.ThanhToan

@{
    ViewBag.Title = "Thanh toán SePay";

    string qrUrl = ViewBag.QRUrl as string;
    string bankName = ViewBag.BankName as string;
    string vaNumber = ViewBag.VaNumber as string;
    string accountNumber = ViewBag.AccountNumber as string;
    string accountName = ViewBag.AccountHolderName as string;
    string expiredAt = ViewBag.ExpiredAt as string;
    string loiSePay = ViewBag.LoiSePay as string;

    string kiemTraUrl = ViewBag.KiemTraUrl as string;
    string thanhCongUrl = ViewBag.ThanhCongUrl as string;
}

<div class="container py-5">
    <div class="mx-auto" style="max-width:620px;">
        <div class="card shadow-sm">

            <div class="card-header text-center bg-dark text-white p-4">
                <h3 class="fw-bold mb-1">THANH TOÁN SEPAY</h3>
                <div>Đơn hàng #@Model.MaDonHang</div>
            </div>

            <div class="card-body text-center p-4">

                @if (Model.TrangThai == "DaThanhToan")
                {
                    <div class="alert alert-success">
                        <h4>Thanh toán thành công!</h4>
                        Hệ thống đã nhận được tiền của bạn.
                    </div>

                    <a href="@Url.Action("ThanhCong", "DonHang", new { id = Model.MaDonHang })"
                       class="btn btn-dark">
                        Xem đơn hàng
                    </a>
                }
                else if (string.IsNullOrWhiteSpace(qrUrl))
                {
                    <div class="alert alert-danger">
                        <h5>Không thể tạo mã QR thanh toán</h5>
                        @(string.IsNullOrWhiteSpace(loiSePay)
                            ? "Vui lòng thử tải lại trang hoặc liên hệ quản trị viên."
                            : loiSePay)
                    </div>

                    <a href="@Url.Action("LichSu", "DonHang")"
                       class="btn btn-outline-dark">
                        Quay lại đơn hàng
                    </a>
                }
                else
                {
                    <h4 class="fw-bold text-danger mb-3">
                        @Model.SoTien.ToString("N0") đ
                    </h4>

                    <img src="@qrUrl"
                         alt="Mã QR thanh toán SePay"
                         style="width:270px;max-width:100%;height:auto;" />

                    <p class="mt-3">
                        Mở ứng dụng ngân hàng và quét mã QR để thanh toán.
                    </p>

                    <div class="text-start border rounded p-3 mt-4">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Ngân hàng</span>
                            <strong>@bankName</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Số tài khoản VA</span>
                            <strong>@vaNumber</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(accountNumber))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tài khoản ngân hàng liên kết</span>
                                <strong>@accountNumber</strong>
                            </div>
                        }

                        <div class="d-flex justify-content-between mb-2">
                            <span>Chủ tài khoản</span>
                            <strong>@accountName</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Số tiền</span>
                            <strong>@Model.SoTien.ToString("N0") đ</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span>Mã đơn hàng</span>
                            <strong id="maChuyenKhoan">
                                @Model.MaThamChieu
                            </strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(expiredAt))
                        {
                            <div class="d-flex justify-content-between mt-2">
                                <span>Thời hạn thanh toán</span>
                                <strong>@expiredAt</strong>
                            </div>
                        }
                    </div>

                    <button type="button"
                            class="btn btn-outline-secondary mt-3"
                            onclick="saoChepMa()">
                        Sao chép mã đơn hàng
                    </button>

                    <div id="trangThaiThanhToan"
                         class="alert alert-warning mt-4"
                         aria-live="polite">
                        Đang chờ thanh toán...
                    </div>

                    <p class="text-secondary small">
                        Vui lòng thanh toán đúng số tiền và giữ nguyên mã đơn hàng
                        để hệ thống đối chiếu giao dịch.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.TrangThai != "DaThanhToan" &&
     !string.IsNullOrWhiteSpace(qrUrl))
{
    <script>
        (function () {
            const statusUrl = @Html.Raw(
                new System.Web.Script.Serialization.JavaScriptSerializer()
                    .Serialize(kiemTraUrl)
            );

            const successUrl = @Html.Raw(
                new System.Web.Script.Serialization.JavaScriptSerializer()
                    .Serialize(thanhCongUrl)
            );

            const statusBox =
                document.getElementById("trangThaiThanhToan");

            let dangKiemTra = false;

            async function kiemTraThanhToan() {
                if (dangKiemTra) return;

                dangKiemTra = true;

                try {
                    const response = await fetch(statusUrl, {
                        method: "GET",
                        cache: "no-store",
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        throw new Error(
                            "Không kiểm tra được trạng thái."
                        );
                    }

                    const data = await response.json();

                    if (data.daThanhToan) {
                        statusBox.className =
                            "alert alert-success mt-4";

                        statusBox.textContent =
                            "Thanh toán thành công!";

                        window.location.href = successUrl;
                        return;
                    }

                    statusBox.textContent =
                        "Đang chờ SePay xác nhận giao dịch...";

                } catch (error) {
                    statusBox.textContent =
                        "Chưa kiểm tra được trạng thái. Hệ thống sẽ thử lại.";
                } finally {
                    dangKiemTra = false;
                }

                window.setTimeout(kiemTraThanhToan, 3000);
            }

            kiemTraThanhToan();
        })();

        function saoChepMa() {
            const element =
                document.getElementById("maChuyenKhoan");

            const ma = element.textContent.trim();

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(ma)
                    .then(function () {
                        alert("Đã sao chép mã đơn hàng.");
                    })
                    .catch(function () {
                        alert("Không sao chép được. Vui lòng sao chép thủ công: " + ma);
                    });
            } else {
                alert("Mã đơn hàng: " + ma);
            }
        }
    </script>
}
