@model System.Collections.Generic.IList<Do_an.Models.SanPham>
@using Do_an.Models
@using Do_an.Services
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq

@helper TheSanPham(
    SanPham sanPham,
    bool laSanPhamMoi,
    DateTime thoiDiem)
{
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var anh = sanPham.HinhAnhSanPhams
        .Where(x => !string.IsNullOrWhiteSpace(x.DuongDanAnh))
        .OrderByDescending(x => x.AnhDaiDien)
        .ThenBy(x => x.ThuTu)
        .ThenBy(x => x.MaHinhAnh)
        .FirstOrDefault();

    var giaGoc = sanPham.BienTheSanPhams
        .Where(x => x.DangBan)
        .Select(x => (decimal?)x.GiaBan)
        .Min();

    var nhan = laSanPhamMoi
        ? "Hàng mới"
        : QuyTacSanPham.Nhan(
            sanPham.PhanTramGiam,
            sanPham.NgayTao,
            thoiDiem);

    string lopNhan = "";

    if (nhan == "Hàng mới")
    {
        lopNhan = "catalog-badge-new";
    }
    else if (nhan == "Giảm giá")
    {
        lopNhan = "catalog-badge-sale";
    }

    <a class="catalog-card"
       href="@Url.Action("ChiTiet", "SanPham", new
       {
           area = "",
           id = sanPham.MaSanPham
       })">
        <div class="catalog-card-media">
            @if (anh != null)
            {
                <img src="@Url.Content(anh.DuongDanAnh)"
                     alt=""
                     loading="lazy" />
            }
            else
            {
                <span class="catalog-card-placeholder">
                    Chưa có ảnh
                </span>
            }

            @if (!string.IsNullOrEmpty(nhan))
            {
                <span class="catalog-badge @lopNhan">
                    @nhan
                </span>
            }
        </div>

        <div class="catalog-card-body">
            <p class="catalog-card-category">
                @(sanPham.LoaiHang == null
                    ? "Sản phẩm thể thao"
                    : sanPham.LoaiHang.TenLoaiHang)
            </p>

            <h3>@sanPham.TenSanPham</h3>

            <div class="catalog-card-prices">
                @if (giaGoc.HasValue)
                {
                    var giaSale = QuyTacSanPham.GiaSauGiam(
                        giaGoc.Value,
                        sanPham.PhanTramGiam);

                    <strong>
                        Từ @giaSale.ToString("N0", vi) đ
                    </strong>

                    if (sanPham.PhanTramGiam > 0)
                    {
                        <del>
                            @giaGoc.Value.ToString("N0", vi) đ
                        </del>
                    }
                }
                else
                {
                    <strong>Xem chi tiết</strong>
                }
            </div>
        </div>
    </a>
}

@{
    ViewBag.Title = "Sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var thoiDiem = DateTime.Now;

    var sanPhamMoi = ViewBag.SanPhamMoi as IList<SanPham>
        ?? new List<SanPham>();

    int tongTrang = Math.Max(
        1,
        Convert.ToInt32(ViewBag.TongTrang));

    int trang = Math.Max(
        1,
        Math.Min(
            Convert.ToInt32(ViewBag.Trang),
            tongTrang));

    int tongSanPham = ViewBag.TongSanPham == null
        ? Model.Count
        : Convert.ToInt32(ViewBag.TongSanPham);

    long giaToiDa = ViewBag.GiaToiDa == null
        ? 5000000L
        : Convert.ToInt64(ViewBag.GiaToiDa);

    long? giaDaLoc = ViewBag.GiaDen == null
        ? (long?)null
        : Convert.ToInt64(ViewBag.GiaDen);

    giaToiDa = Math.Max(giaToiDa, giaDaLoc ?? 0L);
    long giaDangChon = Math.Max(0L, giaDaLoc ?? giaToiDa);

    string urlDanhSach = Url.Action(
        "Index",
        "SanPham",
        new { area = "" });

    int trangBatDau = Math.Max(
        1,
        Math.Min(trang - 2, tongTrang - 4));

    int trangKetThuc = Math.Min(
        tongTrang,
        trangBatDau + 4);

    Func<int, string> urlTrang = soTrang => Url.Action(
        "Index",
        "SanPham",
        new
        {
            area = "",
            trang = soTrang,
            tuKhoa = Request.QueryString["tuKhoa"],
            loaiHang = Request.QueryString["loaiHang"],
            thuongHieu = Request.QueryString["thuongHieu"],
            giaTu = Request.QueryString["giaTu"],
            giaDen = Request.QueryString["giaDen"],
            sapXep = Request.QueryString["sapXep"]
        });
}

@section Styles {
    <link href="@Url.Content("~/Content/san-pham.css")"
          rel="stylesheet" />
}

<div class="container py-4 sportix-catalog sportix-catalog-page">
    <section class="catalog-hero"
             aria-labelledby="tieuDeSanPham"
             data-reveal>
        <div class="catalog-hero-copy">
            <span class="catalog-eyebrow">
                <i class="bi bi-lightning-charge-fill"
                   aria-hidden="true"></i>
                SPORTIX STORE
            </span>

            <h1 id="tieuDeSanPham">Sản phẩm thể thao</h1>

            <p>
                Khám phá giày, trang phục và phụ kiện
                cho bộ môn bạn yêu thích.
            </p>
        </div>

        <img class="catalog-hero-image"
             src="@Url.Content("~/Content/images/product-hero.jpg")"
             alt="Trang phục và dụng cụ thể thao SPORTIX" />
    </section>

    @if (sanPhamMoi.Count > 0)
    {
        <section class="catalog-arrivals"
                 aria-labelledby="tieuDeSanPhamMoi"
                 data-reveal>
            <div class="catalog-arrivals-heading">
                <div>
                    <span class="catalog-new-tag">HÀNG MỚI</span>
                    <h2 id="tieuDeSanPhamMoi">Vừa cập bến</h2>
                </div>

                <div class="catalog-arrivals-controls">
                    <button id="sanPhamMoiTruoc"
                            type="button"
                            class="catalog-scroll-button"
                            aria-label="Xem sản phẩm trước"
                            aria-controls="sanPhamMoi"
                            disabled>
                        <i class="bi bi-chevron-left"
                           aria-hidden="true"></i>
                    </button>

                    <button id="sanPhamMoiSau"
                            type="button"
                            class="catalog-scroll-button"
                            aria-label="Xem sản phẩm tiếp theo"
                            aria-controls="sanPhamMoi">
                        <i class="bi bi-chevron-right"
                           aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <ul id="sanPhamMoi"
                class="catalog-arrivals-track"
                aria-label="Sản phẩm mới trong 30 ngày">
                @foreach (var sanPham in sanPhamMoi)
                {
                    <li class="catalog-arrival-item">
                        @TheSanPham(sanPham, true, thoiDiem)
                    </li>
                }
            </ul>
        </section>
    }

    @using (Html.BeginForm(
        "Index",
        "SanPham",
        new { area = "" },
        FormMethod.Get,
        new
        {
            @class = "row g-4 align-items-start",
            data_skip_splash = "true"
        }))
    {
        @Html.Hidden("giaTu", (object)ViewBag.GiaTu)

        <aside class="col-lg-3" aria-labelledby="tieuDeBoLoc">
            <div class="card catalog-filter">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-4">
                        <h2 id="tieuDeBoLoc" class="h5 mb-0">
                            <i class="bi bi-sliders2 text-primary me-1"
                               aria-hidden="true"></i>
                            Bộ lọc
                        </h2>

                        <a class="small text-decoration-none"
                           href="@urlDanhSach"
                           data-skip-splash="true">
                            Xóa
                        </a>
                    </div>

                    <div class="mb-4">
                        @Html.Label(
                            "loaiHang",
                            "Danh mục",
                            new { @class = "form-label fw-semibold" })

                        @Html.DropDownList(
                            "loaiHang",
                            (SelectList)ViewBag.LoaiHang,
                            "Tất cả danh mục",
                            new { @class = "form-select" })
                    </div>

                    <div class="mb-4">
                        @Html.Label(
                            "thuongHieu",
                            "Thương hiệu",
                            new { @class = "form-label fw-semibold" })

                        @Html.DropDownList(
                            "thuongHieu",
                            (SelectList)ViewBag.ThuongHieu,
                            "Tất cả thương hiệu",
                            new { @class = "form-select" })
                    </div>

                    <div class="mb-4">
                        <div class="d-flex flex-wrap justify-content-between gap-1 mb-2">
                            <label class="form-label fw-semibold mb-0"
                                   for="giaDen">
                                Giá tối đa
                            </label>

                            <output id="nhanGiaToiDa"
                                    class="text-primary fw-semibold"
                                    for="giaDen">
                                @giaDangChon.ToString("N0", vi) đ
                            </output>
                        </div>

                        <input type="range"
                               id="giaDen"
                               name="giaDen"
                               class="form-range"
                               min="0"
                               max="@giaToiDa.ToString(CultureInfo.InvariantCulture)"
                               step="1"
                               value="@giaDangChon.ToString(CultureInfo.InvariantCulture)" />

                        <div class="d-flex justify-content-between small text-secondary">
                            <span>0 đ</span>
                            <span>@giaToiDa.ToString("N0", vi) đ</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        @Html.Label(
                            "sapXep",
                            "Sắp xếp",
                            new { @class = "form-label fw-semibold" })

                        @Html.DropDownList(
                            "sapXep",
                            (SelectList)ViewBag.SapXep,
                            new { @class = "form-select" })
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Áp dụng bộ lọc
                    </button>
                </div>
            </div>
        </aside>

        <section class="col-lg-9"
                 aria-labelledby="tieuDeDanhSach">
            <div class="catalog-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h2 id="tieuDeDanhSach"
                        class="h5 fw-bold mb-1">
                        Danh sách sản phẩm
                    </h2>

                    <p class="small text-secondary mb-0">
                        Hiển thị @Model.Count / @tongSanPham sản phẩm
                    </p>
                </div>

                <div class="d-flex gap-2">
                    @Html.Label(
                        "tuKhoa",
                        "Tìm sản phẩm",
                        new { @class = "visually-hidden" })

                    @Html.TextBox(
                        "tuKhoa",
                        (string)ViewBag.TuKhoa,
                        new
                        {
                            @class = "form-control",
                            type = "search",
                            placeholder = "Tìm theo tên sản phẩm"
                        })

                    <button type="submit"
                            class="btn btn-outline-primary"
                            aria-label="Tìm kiếm">
                        <i class="bi bi-search"
                           aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "text-danger mb-3" })

            @if (Model.Count == 0)
            {
                <div class="card border-0">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-search fs-2 text-primary"
                           aria-hidden="true"></i>

                        <h3 class="h5 mt-3">
                            Không tìm thấy sản phẩm
                        </h3>

                        <p class="text-secondary">
                            Thử đổi từ khóa hoặc xóa bộ lọc
                            để xem thêm sản phẩm.
                        </p>

                        <a class="btn btn-outline-primary"
                           href="@urlDanhSach"
                           data-skip-splash="true">
                            Xóa bộ lọc
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="catalog-product-grid">
                    @foreach (var sanPham in Model)
                    {
                        <div class="catalog-product-item" data-reveal>
                            @TheSanPham(sanPham, false, thoiDiem)
                        </div>
                    }
                </div>
            }
        </section>

        <nav class="col-12 mt-4"
             aria-label="Phân trang sản phẩm">
            <ul class="pagination justify-content-center flex-wrap gap-1 mb-2">
                @if (trang > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="@urlTrang(1)"
                           data-skip-splash="true"
                           aria-label="Trang đầu">
                            &laquo;
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link"
                           href="@urlTrang(trang - 1)"
                           data-skip-splash="true"
                           aria-label="Trang trước"
                           rel="prev">
                            &lsaquo;
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"
                              aria-label="Trang đầu"
                              aria-disabled="true">
                            &laquo;
                        </span>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link"
                              aria-label="Trang trước"
                              aria-disabled="true">
                            &lsaquo;
                        </span>
                    </li>
                }

                @if (trangBatDau > 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                }

                @for (int soTrang = trangBatDau;
                    soTrang <= trangKetThuc;
                    soTrang++)
                {
                    if (soTrang == trang)
                    {
                        <li class="page-item active">
                            <span class="page-link"
                                  aria-current="page"
                                  aria-label="@("Trang " + soTrang)">
                                @soTrang
                            </span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@urlTrang(soTrang)"
                               data-skip-splash="true"
                               aria-label="@("Trang " + soTrang)">
                                @soTrang
                            </a>
                        </li>
                    }
                }

                @if (trangKetThuc < tongTrang)
                {
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                }

                @if (trang < tongTrang)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="@urlTrang(trang + 1)"
                           data-skip-splash="true"
                           aria-label="Trang sau"
                           rel="next">
                            &rsaquo;
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link"
                           href="@urlTrang(tongTrang)"
                           data-skip-splash="true"
                           aria-label="Trang cuối">
                            &raquo;
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"
                              aria-label="Trang sau"
                              aria-disabled="true">
                            &rsaquo;
                        </span>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link"
                              aria-label="Trang cuối"
                              aria-disabled="true">
                            &raquo;
                        </span>
                    </li>
                }
            </ul>

            <p class="small text-secondary text-center mb-0">
                Trang @trang / @tongTrang
            </p>
        </nav>
    }
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/san-pham.js")"></script>
}