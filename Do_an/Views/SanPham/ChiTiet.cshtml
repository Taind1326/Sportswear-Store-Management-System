
@model Do_an.Models.SanPham
@using System
@using System.Linq
@using System.Globalization
@using Do_an.Services

@{
    ViewBag.Title = Model.TenSanPham;
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var danhSachAnh = Model.HinhAnhSanPhams
        .Where(x => !string.IsNullOrWhiteSpace(x.DuongDanAnh))
        .OrderByDescending(x => x.AnhDaiDien)
        .ThenBy(x => x.ThuTu)
        .ThenBy(x => x.MaHinhAnh)
        .ToList();

    var anhDaiDien = danhSachAnh.FirstOrDefault();

    string anhMacDinh = anhDaiDien == null
        ? ""
        : Url.Content(anhDaiDien.DuongDanAnh);

    var phanLoai = Model.BienTheSanPhams
        .Where(x => x.DangBan)
        .OrderBy(x => x.MauSac)
        .ThenBy(x => x.KichThuoc)
        .ToList();

    var nhomMau = phanLoai
        .GroupBy(
            x => QuyTacSanPham.ChuanHoa(x.MauSac),
            StringComparer.OrdinalIgnoreCase)
        .ToList();

    var danhSachGia = phanLoai
        .Select(x => QuyTacSanPham.GiaSauGiam(
            x.GiaBan,
            Model.PhanTramGiam))
        .ToList();

    string giaBanDau = "Chưa có phân loại đang bán";

    if (danhSachGia.Count > 0)
    {
        decimal thapNhat = danhSachGia.Min();
        decimal caoNhat = danhSachGia.Max();

        giaBanDau = thapNhat.ToString("N0", vi) + " đ";

        if (thapNhat != caoNhat)
        {
            giaBanDau += " – " + caoNhat.ToString("N0", vi) + " đ";
        }
    }
}

@section Styles {
    <link href="@Url.Content("~/Content/chi-tiet-san-pham.css")"
          rel="stylesheet" />
}

<div id="chiTietSanPham"
     class="sportix-detail container py-4 py-lg-5"
     data-api="@Url.Action("BienThe", "SanPham", new { area = "", id = Model.MaSanPham })"
     data-anh-mac-dinh="@anhMacDinh"
     data-gia-ban-dau="@giaBanDau">

    <nav class="mb-3" aria-label="Đường dẫn">
        <a href="@Url.Action("Index", "SanPham", new { area = "" })"
           class="text-decoration-none">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Danh sách sản phẩm
        </a>
    </nav>

    <div class="detail-card">

        <div>
            <div class="detail-main-image">
                @if (!string.IsNullOrEmpty(anhMacDinh))
                {
                    <img id="anhSanPham"
                         src="@anhMacDinh"
                         alt="@Model.TenSanPham" />
                }
                else
                {
                    <span class="text-secondary">
                        Chưa có ảnh sản phẩm
                    </span>
                }
            </div>

            @if (danhSachAnh.Count > 1)
            {
                <div class="detail-thumbs mt-3"
                     role="group"
                     aria-label="Chọn ảnh sản phẩm">

                    @foreach (var anh in danhSachAnh)
                    {
                        string duongDan = Url.Content(anh.DuongDanAnh);

                        <button type="button"
                                class="detail-option detail-thumb"
                                data-anh="@duongDan"
                                aria-label="Xem ảnh sản phẩm @anh.MaHinhAnh"
                                aria-pressed="@(duongDan == anhMacDinh ? "true" : "false")">

                            <img src="@duongDan"
                                 alt=""
                                 loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="detail-info">

            <h1>@Model.TenSanPham</h1>

            @if (Model.ThuongHieu != null)
            {
                <p class="text-secondary mb-3">
                    @Model.ThuongHieu.TenThuongHieu
                </p>
            }

            <div id="giaSanPham"
                 class="detail-price"
                 aria-live="polite">
                @giaBanDau
            </div>

            @if (Model.PhanTramGiam > 0)
            {
                <span class="badge bg-primary mt-2">
                    Giảm @Model.PhanTramGiam%
                </span>
            }

            @if (nhomMau.Count > 0)
            {
                <div class="mt-4">

                    <h2 class="h6 fw-semibold">Màu</h2>

                    <div class="detail-options"
                         role="group"
                         aria-label="Chọn màu">

                        @for (int i = 0; i < nhomMau.Count; i++)
                        {
                            string mau = nhomMau[i].Key;

                            var anhMau = danhSachAnh.FirstOrDefault(x =>
                                !string.IsNullOrWhiteSpace(x.MauSac) &&
                                string.Equals(
                                    QuyTacSanPham.ChuanHoa(x.MauSac),
                                    mau,
                                    StringComparison.OrdinalIgnoreCase));

                            string duongDan = anhMau == null
                                ? anhMacDinh
                                : Url.Content(anhMau.DuongDanAnh);

                            string nhan = mau == "Mặc định"
                                ? Model.TenSanPham
                                : Model.TenSanPham + " - " + mau;

                            <button type="button"
                                    class="detail-option detail-color"
                                    data-mau="@i"
                                    data-anh-mau="@duongDan"
                                    aria-pressed="false">

                                @if (!string.IsNullOrEmpty(duongDan))
                                {
                                    <img src="@duongDan"
                                         alt=""
                                         loading="lazy" />
                                }

                                <span>@nhan</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-4">

                    <h2 class="h6 fw-semibold">
                        Kích cỡ / dung tích
                    </h2>

                    <p id="huongDanChonMau" class="text-secondary">
                        Chọn màu để xem kích cỡ.
                    </p>

                    @for (int i = 0; i < nhomMau.Count; i++)
                    {
                        <div class="detail-sizes"
                             data-nhom-size="@i"
                             role="group"
                             aria-label="Chọn kích cỡ"
                             hidden>

                            @foreach (var bienThe in nhomMau[i])
                            {
                                bool hetHang = bienThe.SoLuongTon <= 0;

                                if (hetHang)
                                {
                                    <button type="button"
                                            class="detail-option"
                                            data-bien-the="@bienThe.MaBienThe"
                                            aria-pressed="false"
                                            disabled="disabled">

                                        <span>
                                            @QuyTacSanPham.ChuanHoa(bienThe.KichThuoc)
                                        </span>

                                        <span class="small">
                                            (Hết hàng)
                                        </span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="detail-option"
                                            data-bien-the="@bienThe.MaBienThe"
                                            aria-pressed="false">

                                        <span>
                                            @QuyTacSanPham.ChuanHoa(bienThe.KichThuoc)
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>

                <p id="tonSanPham"
                   class="text-secondary mt-3 mb-2"
                   aria-live="polite">
                </p>

                using (Html.BeginForm(
                    "Them",
                    "GioHang",
                    FormMethod.Post,
                    new { id = "formThemGioHang" }))
                {
                    @Html.AntiForgeryToken()

                    <div id="vungSoLuong" hidden>

                        <div class="mb-3">

                            <label for="soLuongSanPham"
                                   class="form-label">
                                Số lượng
                            </label>

                            <input id="soLuongSanPham"
                                   name="soLuong"
                                   type="number"
                                   class="form-control"
                                   value="1"
                                   min="1"
                                   step="1"
                                   disabled />

                            <input id="maBienTheDangChon"
                                   name="maBienThe"
                                   type="hidden" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-cart-plus"
                               aria-hidden="true"></i>

                            Thêm vào giỏ hàng
                        </button>

                    </div>
                }
            }

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
    {
        <section class="detail-description mt-4"
                 aria-labelledby="tieuDeMoTa"
                 data-reveal="">

            <h2 id="tieuDeMoTa"
                class="h5 fw-bold mb-3">
                Thông tin sản phẩm
            </h2>

            <p>@Model.MoTa</p>
        </section>
    }

</div>

@section Scripts {

    <script>
        (function () {
            "use strict";

            const trang = document.getElementById("chiTietSanPham");

            if (!trang) return;

            const anhLon = document.getElementById("anhSanPham");
            const gia = document.getElementById("giaSanPham");
            const ton = document.getElementById("tonSanPham");
            const huongDan = document.getElementById("huongDanChonMau");

            const vungSoLuong = document.getElementById("vungSoLuong");
            const soLuong = document.getElementById("soLuongSanPham");
            const maBienThe = document.getElementById("maBienTheDangChon");

            const formThemGioHang = document.getElementById("formThemGioHang");

            const anhNho = trang.querySelectorAll("[data-anh]");
            const cacMau = trang.querySelectorAll("[data-mau]");
            const cacNhomSize = trang.querySelectorAll("[data-nhom-size]");
            const cacSize = trang.querySelectorAll("[data-bien-the]");

            const dinhDang = new Intl.NumberFormat("vi-VN");

            let mauDangChon = null;
            let lanChon = 0;

            function doiAnh(duongDan) {
                if (!anhLon || !duongDan) return;

                anhLon.src = duongDan;

                anhNho.forEach(function (nut) {
                    nut.setAttribute(
                        "aria-pressed",
                        String(nut.dataset.anh === duongDan)
                    );
                });
            }

            function xoaLuaChonSoLuong() {
                if (!vungSoLuong || !soLuong || !maBienThe) return;

                vungSoLuong.hidden = true;
                soLuong.disabled = true;
                soLuong.value = 1;
                soLuong.removeAttribute("max");
                maBienThe.value = "";
            }

            // Kiểm tra dữ liệu trước khi gửi giỏ hàng.
            if (formThemGioHang) {
                formThemGioHang.addEventListener("submit", function (event) {

                    const maBienTheChon = Number(maBienThe.value);
                    const soLuongChon = Number(soLuong.value);
                    const soLuongToiDa = Number(soLuong.max);

                    if (
                        !Number.isInteger(maBienTheChon) ||
                        maBienTheChon <= 0 ||
                        !Number.isInteger(soLuongChon) ||
                        soLuongChon < 1 ||
                        !Number.isInteger(soLuongToiDa) ||
                        soLuongChon > soLuongToiDa
                    ) {
                        event.preventDefault();

                        alert("Vui lòng chọn phân loại và số lượng hợp lệ.");
                    }
                });
            }

            // Chọn ảnh thu nhỏ.
            anhNho.forEach(function (nut) {

                nut.addEventListener("click", function () {
                    doiAnh(nut.dataset.anh);
                });

            });

            // Chọn màu sắc.
            cacMau.forEach(function (nut) {

                nut.addEventListener("click", function () {

                    lanChon++;

                    xoaLuaChonSoLuong();

                    mauDangChon = mauDangChon === nut ? null : nut;

                    cacMau.forEach(function (mau) {

                        mau.setAttribute(
                            "aria-pressed",
                            String(mau === mauDangChon)
                        );

                    });

                    cacNhomSize.forEach(function (nhom) {

                        nhom.hidden = !mauDangChon ||
                            nhom.dataset.nhomSize !== mauDangChon.dataset.mau;

                    });

                    cacSize.forEach(function (size) {

                        size.setAttribute("aria-pressed", "false");

                    });

                    if (huongDan) {
                        huongDan.hidden = !!mauDangChon;
                    }

                    if (gia) {
                        gia.textContent = trang.dataset.giaBanDau;
                    }

                    if (ton) {
                        ton.textContent = mauDangChon
                            ? "Chọn kích cỡ để xem giá và tồn kho."
                            : "";
                    }

                    doiAnh(
                        mauDangChon
                            ? mauDangChon.dataset.anhMau
                            : trang.dataset.anhMacDinh
                    );

                });

            });

            // Chọn kích cỡ và kiểm tra tồn kho.
            cacSize.forEach(function (nut) {

                nut.addEventListener("click", async function () {

                    const yeuCau = ++lanChon;

                    xoaLuaChonSoLuong();

                    cacSize.forEach(function (size) {

                        size.setAttribute(
                            "aria-pressed",
                            String(size === nut)
                        );

                    });

                    if (gia) {
                        gia.textContent = trang.dataset.giaBanDau;
                    }

                    if (ton) {
                        ton.textContent = "Đang kiểm tra tồn kho…";
                    }

                    try {

                        const url = new URL(
                            trang.dataset.api,
                            window.location.href
                        );

                        url.searchParams.set(
                            "maBienThe",
                            nut.dataset.bienThe
                        );

                        const response = await fetch(url, {
                            cache: "no-store"
                        });

                        if (yeuCau !== lanChon) return;

                        if (response.status === 404) {

                            if (ton) {
                                ton.textContent = "Phân loại này không còn bán.";
                            }

                            nut.disabled = true;

                            return;
                        }

                        if (!response.ok) {
                            throw new Error("Không tải được phân loại.");
                        }

                        const bienThe = await response.json();

                        if (yeuCau !== lanChon) return;

                        if (gia) {

                            gia.textContent =
                                dinhDang.format(bienThe.GiaSauGiam) + " đ";

                        }

                        if (ton) {

                            ton.textContent = bienThe.ConHang
                                ? "Còn " +
                                dinhDang.format(bienThe.SoLuongTon) +
                                " sản phẩm"
                                : "Hết hàng";

                        }

                        if (bienThe.ConHang && bienThe.SoLuongTon > 0) {

                            soLuong.max = bienThe.SoLuongTon;
                            soLuong.value = 1;
                            soLuong.disabled = false;

                            maBienThe.value = bienThe.MaBienThe;

                            vungSoLuong.hidden = false;

                        } else {

                            nut.disabled = true;

                        }

                    } catch (error) {

                        if (yeuCau === lanChon && ton) {

                            ton.textContent =
                                "Chưa tải được giá và tồn kho. Mời bạn chọn lại kích cỡ.";

                        }

                    }

                });

            });

        })();
    </script>
}
