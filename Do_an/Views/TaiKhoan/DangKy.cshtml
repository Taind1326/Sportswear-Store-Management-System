@model Do_an.ViewModels.DangKyViewModel

@{
    ViewBag.Title = "Đăng ký";
}

@section Styles {
    <link href="@Url.Content("~/Content/auth.css")" rel="stylesheet" />
}

<section class="auth-page">
    <div class="auth-card">
        <span class="auth-tag">JOIN SPORTIX</span>
        <h1 class="auth-title">Đăng ký tài khoản</h1>
        <p class="auth-sub">Tạo tài khoản để mua sắm đồ thể thao chính hãng và nhận ưu đãi riêng.</p>

        <div class="auth-steps" aria-label="Các bước đăng ký">
            <div class="auth-step is-active" data-step="1">
                <span class="auth-dot"><span class="auth-dot-num">1</span><i class="bi bi-check-lg auth-dot-check" aria-hidden="true"></i></span>
                <span class="auth-step-label">Thông tin</span>
            </div>
            <span class="auth-line"></span>
            <div class="auth-step" data-step="2">
                <span class="auth-dot"><span class="auth-dot-num">2</span><i class="bi bi-check-lg auth-dot-check" aria-hidden="true"></i></span>
                <span class="auth-step-label">Mật khẩu</span>
            </div>
            <span class="auth-line"></span>
            <div class="auth-step" data-step="3">
                <span class="auth-dot"><span class="auth-dot-num">3</span><i class="bi bi-check-lg auth-dot-check" aria-hidden="true"></i></span>
                <span class="auth-step-label">Xác nhận</span>
            </div>
        </div>

        @using (Html.BeginForm("DangKy", "TaiKhoan", new { area = "" },
            FormMethod.Post, new { id = "formDangKy", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)
            @Html.ValidationSummary(true)

            @* ================= BƯỚC 1: THÔNG TIN ================= *@
            <div data-pane="1">
                <div class="auth-row2">
                    <div class="auth-field">
                        <label class="auth-label" for="Ho">Họ</label>
                        <div class="auth-input">
                            <i class="bi bi-person lead" aria-hidden="true"></i>
                            @Html.TextBoxFor(m => m.Ho, new { placeholder = "Nguyễn", maxlength = "45", autocomplete = "family-name" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Ho, "", new { @class = "auth-error" })
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" for="Ten">Tên</label>
                        <div class="auth-input">
                            <i class="bi bi-person lead" aria-hidden="true"></i>
                            @Html.TextBoxFor(m => m.Ten, new { placeholder = "Văn A", maxlength = "45", autocomplete = "given-name" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Ten, "", new { @class = "auth-error" })
                    </div>
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="Email">Email</label>
                    <div class="auth-input">
                        <i class="bi bi-envelope-fill lead" aria-hidden="true"></i>
                        @Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "ten@email.com", maxlength = "254", autocomplete = "email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "auth-error" })
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="SoDienThoai">Số điện thoại</label>
                    <div class="auth-input">
                        <i class="bi bi-telephone-fill lead" aria-hidden="true"></i>
                        @Html.TextBoxFor(m => m.SoDienThoai, new { type = "tel", placeholder = "0987654321", maxlength = "20", autocomplete = "tel" })
                    </div>
                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "auth-error" })
                </div>

                <div class="auth-actions">
                    <button type="button" class="auth-submit" data-next>
                        Tiếp theo <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @* ================= BƯỚC 2: MẬT KHẨU ================= *@
            <div data-pane="2" hidden>
                <div class="auth-field">
                    <label class="auth-label" for="MatKhau">Mật khẩu</label>
                    <div class="auth-input">
                        <i class="bi bi-shield-lock-fill lead" aria-hidden="true"></i>
                        @Html.PasswordFor(m => m.MatKhau, new { placeholder = "Nhập mật khẩu mạnh", autocomplete = "new-password" })
                        <button type="button" class="auth-eye" data-toggle-password aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="auth-meter"><span class="auth-meter-bar" id="meterBar"></span></div>
                    <div class="auth-meter-text" id="meterText"></div>
                    @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "auth-error" })
                </div>

                <div class="auth-field">
                    <label class="auth-label" for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                    <div class="auth-input">
                        <i class="bi bi-shield-check lead" aria-hidden="true"></i>
                        @Html.PasswordFor(m => m.XacNhanMatKhau, new { placeholder = "Nhập lại mật khẩu", autocomplete = "new-password" })
                        <button type="button" class="auth-eye" data-toggle-password aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "auth-error" })
                </div>

                <div class="auth-req">
                    <strong>Mật khẩu mạnh cần có:</strong>
                    <ul>
                        <li data-rule="len"><i class="bi bi-circle" aria-hidden="true"></i> Ít nhất 8 ký tự</li>
                        <li data-rule="upper"><i class="bi bi-circle" aria-hidden="true"></i> Chữ hoa A-Z</li>
                        <li data-rule="digit"><i class="bi bi-circle" aria-hidden="true"></i> Chữ số 0-9</li>
                        <li data-rule="special"><i class="bi bi-circle" aria-hidden="true"></i> Ký tự đặc biệt</li>
                    </ul>
                </div>

                <div class="auth-actions">
                    <button type="button" class="auth-back" data-back aria-label="Quay lại">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="auth-submit" data-next>
                        Tiếp theo <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @* ================= BƯỚC 3: XÁC NHẬN ================= *@
            <div data-pane="3" hidden>
                <div class="auth-summary">
                    <div class="auth-summary-title">Xác nhận thông tin</div>
                    <div class="auth-summary-row"><span>Họ tên</span><strong id="sumTen"></strong></div>
                    <div class="auth-summary-row"><span>Email</span><strong id="sumEmail"></strong></div>
                    <div class="auth-summary-row"><span>Điện thoại</span><strong id="sumSdt"></strong></div>
                </div>

                <label class="auth-check">
                    <input type="checkbox" name="DongYDieuKhoan" id="DongYDieuKhoan" value="true"
                           checked="@(Model.DongYDieuKhoan ? "checked" : null)" />
                    <span class="auth-box" aria-hidden="true"></span>
                    <span>
                        Tôi đồng ý với <a href="#" class="auth-link" data-chua-co>Điều khoản dịch vụ</a>
                        và <a href="#" class="auth-link" data-chua-co>Chính sách bảo mật</a> của SPORTIX.
                    </span>
                </label>
                @Html.ValidationMessageFor(m => m.DongYDieuKhoan, "", new { @class = "auth-error" })

                <label class="auth-check" style="margin-top: 12px;">
                    <input type="checkbox" name="NhanThongBao" value="true"
                           checked="@(Model.NhanThongBao ? "checked" : null)" />
                    <span class="auth-box" aria-hidden="true"></span>
                    <span>Nhận thông báo khuyến mãi và sản phẩm mới.</span>
                </label>

                <div class="auth-actions" style="margin-top: 20px;">
                    <button type="button" class="auth-back" data-back aria-label="Quay lại">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </button>
                    <button type="submit" class="auth-submit">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Tạo tài khoản
                    </button>
                </div>
            </div>
        }

        <div class="auth-divider">Hoặc đăng ký với</div>

        <div class="auth-social">
            <button type="button" data-social="Google">
                <svg viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                Google
            </button>
            <button type="button" data-social="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.02 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.88v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.09 24 12.07z" />
                </svg>
                Facebook
            </button>
        </div>
        <p class="auth-note" id="authSocialNote" hidden></p>

        <p class="auth-foot">
            Đã có tài khoản?
            <a class="auth-link" href="@Url.Action("DangNhap", "TaiKhoan", new { area = "", returnUrl = Model.ReturnUrl })">
                Đăng nhập ngay
            </a>
        </p>
    </div>
</section>

@section Scripts {
    <script src="@Url.Content("~/Scripts/auth.js")"></script>
}