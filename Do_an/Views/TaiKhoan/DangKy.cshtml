@model Do_an.ViewModels.DangKyViewModel

@{
    ViewBag.Title = "Đăng ký";
}

@section Styles {
    <link href="@Url.Content("~/Content/tai-khoan.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/validation.css")" rel="stylesheet" />
}

<section class="tk-page">
    <div class="container">
        <div class="tk-card tk-wide">
            <h1 class="tk-title">Tạo tài khoản</h1>
            <p class="tk-sub">Đăng ký để mua sắm và theo dõi đơn hàng tại SPORTIX.</p>

            @using (Html.BeginForm("DangKy", "TaiKhoan", new { area = "" },
                FormMethod.Post, new { novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)

                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.HoTen, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.HoTen, new
                        {
                            @class = "form-control",
                            maxlength = "100",
                            autocomplete = "name"
                        })
                        @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.TenDangNhap, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.TenDangNhap, new
                        {
                            @class = "form-control",
                            maxlength = "50",
                            autocomplete = "username"
                        })
                        @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            type = "email",
                            maxlength = "254",
                            autocomplete = "email"
                        })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.SoDienThoai, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.SoDienThoai, new
                        {
                            @class = "form-control",
                            maxlength = "20",
                            autocomplete = "tel",
                            placeholder = "Không bắt buộc"
                        })
                        @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.MatKhau, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.MatKhau, new
                        {
                            @class = "form-control",
                            autocomplete = "new-password"
                        })
                        @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.XacNhanMatKhau, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.XacNhanMatKhau, new
                        {
                            @class = "form-control",
                            autocomplete = "new-password"
                        })
                        @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
                    </div>
                </div>

                <button type="submit" class="tk-btn mt-4">Đăng ký</button>
            }

            <p class="text-center mt-4 mb-0">
                Đã có tài khoản?
                <a class="tk-link"
                   href="@Url.Action("DangNhap", "TaiKhoan", new { area = "", returnUrl = Model.ReturnUrl })">
                    Đăng nhập
                </a>
            </p>
        </div>
    </div>
</section>