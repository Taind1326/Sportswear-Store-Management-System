@{
    string controller = Convert.ToString(
        ViewContext.RouteData.Values["controller"]);

    bool trangSanPham = controller == "SanPham";
    bool trangDonHang = controller == "DonHang";
    bool trangKhuyenMai = controller == "KhuyenMai";
    bool trangThongBaoWeb = controller == "ThongBaoWebsite";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - SPORTIX Admin</title>

    <link href="@Url.Content("~/Content/bootstrap.min.css")"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/validation.css")"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/admin.css")?v=3"
          rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>

<body class="sportix-admin">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })"
               class="admin-brand"
               aria-label="SPORTIX - Quản lý sản phẩm">
                <img src="@Url.Content("~/Content/sportix/img/logo.jpg")"
                     alt="SPORTIX" />
            </a>

            <p class="admin-caption">QUẢN TRỊ CỬA HÀNG</p>

            <nav class="admin-menu" aria-label="Menu quản trị">
                <span class="admin-menu-item"
                      aria-disabled="true"
                      title="Chưa kết nối chức năng">
                    <i class="bi bi-grid" aria-hidden="true"></i>
                    Dashboard
                </span>

                <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })"
                   class="admin-menu-item @(trangSanPham ? "active" : "")"
                   aria-current="@(trangSanPham ? "page" : null)">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    Quản lý sản phẩm
                </a>

                <a href="@Url.Action("Index", "TaiKhoan", new { area = "Admin" })"
                   class="admin-menu-item">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    Quản lý tài khoản
                </a>

                <a href="@Url.Action("Index", "DonHang", new { area = "Admin" })"
                   class="admin-menu-item @(trangDonHang ? "active" : "")"
                   aria-current="@(trangDonHang ? "page" : null)">
                    <i class="bi bi-cart3" aria-hidden="true"></i>
                    Quản lý đơn hàng
                </a>

                <span class="admin-menu-item"
                      aria-disabled="true"
                      title="Chưa kết nối chức năng">
                    <i class="bi bi-bar-chart" aria-hidden="true"></i>
                    Thống kê
                </span>

                <details class="admin-menu-group" @((trangKhuyenMai || trangThongBaoWeb) ? "open" : "")>
                    <summary>
                        <span>
                            <i class="bi bi-tag" aria-hidden="true"></i>
                            Khuyến mãi
                        </span>

                        <i class="bi bi-chevron-right menu-arrow"
                           aria-hidden="true"></i>
                    </summary>

                    <div class="admin-submenu">
                        <a href="@Url.Action("Index", "KhuyenMai", new { area = "Admin" })"
                           class="admin-menu-item @(trangKhuyenMai ? "active" : "")">
                            Mã giảm giá
                        </a>

                        <a href="@Url.Action("Index", "ThongBaoWebsite", new { area = "Admin" })"
                           class="admin-menu-item @(trangThongBaoWeb ? "active" : "")">
                            Thông báo khuyến mãi
                        </a>
                    </div>
                </details>

                @using (Html.BeginForm("DangXuat", "TaiKhoan", new { area = "" },
                        FormMethod.Post, new { style = "display: contents;" }))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit" class="admin-menu-item admin-logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        Đăng xuất
                    </button>
                }
            </nav>

            <div class="admin-sidebar-note">
                <span></span>
                <p>SPORTIX MANAGEMENT</p>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <nav aria-label="Đường dẫn">
                    <ol class="admin-breadcrumb">
                        <li>
                            <i class="bi bi-house-door"
                               aria-hidden="true"></i>
                            <span class="visually-hidden">Trang quản trị</span>
                        </li>

                        <li>Quản trị</li>

                        <li class="current">
                            @(trangSanPham ? "Sản phẩm" : Convert.ToString(ViewBag.Title))
                        </li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown" id="chuongThongBao"
                         data-url-danh-sach="@Url.Action("DanhSach", "ThongBao", new { area = "Admin" })"
                         data-url-token="@Url.Action("Token", "ThongBao", new { area = "Admin" })"
                         data-url-da-doc="@Url.Action("DaDoc", "ThongBao", new { area = "Admin" })"
                         data-url-doc-tat-ca="@Url.Action("DocTatCa", "ThongBao", new { area = "Admin" })"
                         data-url-don="@Url.Action("ChiTiet", "DonHang", new { area = "Admin" })">
                        <button type="button" class="btn btn-outline-secondary position-relative"
                                id="nutChuong" aria-expanded="false" aria-label="Thông báo">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span id="soChuaDoc"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  hidden>0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-0" id="khungThongBao"
                             style="width: 360px; max-width: 92vw; right: 0; left: auto; top: 100%;">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <strong>Thông báo</strong>
                                <button type="button" class="btn btn-link btn-sm p-0" id="nutDocTatCa">Đánh dấu đã đọc tất cả</button>
                            </div>
                            <div id="danhSachThongBao" style="max-height: 360px; overflow-y: auto;">
                                <p class="text-secondary text-center py-3 mb-0">Đang tải...</p>
                            </div>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "Home", new { area = "" })"
                       class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-2"
                           aria-hidden="true"></i>
                        Về trang cửa hàng
                    </a>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.addEventListener("error", function (event) {
            var anh = event.target;

            if (!(anh instanceof HTMLImageElement) ||
                !anh.classList.contains("product-thumb")) {
                return;
            }

            anh.hidden = true;

            var duPhong = anh.nextElementSibling;

            if (duPhong) {
                duPhong.hidden = false;
            }
        }, true);
    </script>

    <form id="bieuMauCsrf" hidden>@Html.AntiForgeryToken()</form>
    <script src="@Url.Content("~/Scripts/jquery.signalR-2.4.3.min.js")"></script>
    <script src="@Url.Content("~/signalr/hubs")"></script>
    <script src="@Url.Content("~/Scripts/sportix-thongbao-admin.js")?v=1"></script>

    @RenderSection("scripts", required: false)
</body>
</html>