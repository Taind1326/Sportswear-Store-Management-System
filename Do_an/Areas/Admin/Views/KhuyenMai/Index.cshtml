@model System.Collections.Generic.List<Do_an.Models.MaGiamGia>
@using System
@using System.Globalization
@using Do_an.Services

@{
    ViewBag.Title = "Mã giảm giá";

    var vi = CultureInfo.GetCultureInfo("vi-VN");

    string tuKhoa = Convert.ToString(ViewBag.TuKhoa);
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
    int tongSo = ViewBag.TongSo;

    int batDau = Math.Max(
        1,
        Math.Min(trang - 2, tongTrang - 4));

    int ketThuc = Math.Min(tongTrang, batDau + 4);

    DateTime bayGio = DateTime.Now;
}

@helper NutTrang(
    int dich,
    string nhan,
    string moTa,
    bool voHieuHoa,
    string tuKhoa)
{
    <li class="page-item @(voHieuHoa ? "disabled" : "")">
        @if (voHieuHoa)
        {
            <span class="page-link"
                  aria-disabled="true"
                  aria-label="@moTa">
                @nhan
            </span>
        }
        else
        {
            <a class="page-link"
               aria-label="@moTa"
               href="@Url.Action("Index", "KhuyenMai", new
                    {
                        area = "Admin",
                        tuKhoa = tuKhoa,
                        trang = dich
                    })">
                @nhan
            </a>
        }
    </li>
}

<div class="product-page-heading">
    <div>
        <h1>Mã giảm giá</h1>
        <p>Theo dõi mức giảm, thời gian áp dụng và lượt sử dụng.</p>
    </div>

    <a href="@Url.Action("Them", "KhuyenMai", new { area = "Admin" })"
       class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        Thêm mã giảm giá
    </a>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["ThanhCong"]
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Loi"]
    </div>
}

<div class="product-panel">
    @using (Html.BeginForm(
        "Index",
        "KhuyenMai",
        new { area = "Admin" },
        FormMethod.Get,
        new { @class = "product-search" }))
    {
        <div class="product-search-box">
            <label for="tuKhoa" class="visually-hidden">
                Tìm theo mã hoặc tên khuyến mãi
            </label>

            <i class="bi bi-search" aria-hidden="true"></i>

            <input type="search"
                   id="tuKhoa"
                   name="tuKhoa"
                   value="@tuKhoa"
                   maxlength="200"
                   class="form-control"
                   placeholder="Tìm theo mã hoặc tên khuyến mãi..." />
        </div>

        <button type="submit" class="btn btn-primary px-3">
            Tìm kiếm
        </button>

        <a href="@Url.Action("Index", "KhuyenMai", new { area = "Admin" })"
           class="btn btn-outline-secondary px-3">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            Đặt lại
        </a>
    }

    <div class="table-responsive">
        <table class="table table-hover product-table align-middle">
            <thead>
                <tr>
                    <th scope="col">Mã giảm giá</th>
                    <th scope="col">Mức giảm</th>
                    <th scope="col">Đơn tối thiểu</th>
                    <th scope="col">Thời gian áp dụng</th>
                    <th scope="col">Lượt sử dụng</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-secondary py-5">
                            Không tìm thấy mã giảm giá phù hợp.
                        </td>
                    </tr>
                }

                @foreach (var ma in Model)
                {
                    string trangThai;
                    string lopTrangThai;

                    if (!ma.HoatDong)
                    {
                        trangThai = "Đang tắt";
                        lopTrangThai = "status-stopped";
                    }
                    else if (bayGio > ma.NgayKetThuc)
                    {
                        trangThai = "Hết hạn";
                        lopTrangThai = "status-stopped";
                    }
                    else if (bayGio < ma.NgayBatDau)
                    {
                        trangThai = "Chưa đến lịch";
                        lopTrangThai = "status-low";
                    }
                    else if (ma.SoLuotDaDung >= ma.SoLuotToiDa)
                    {
                        trangThai = "Hết lượt";
                        lopTrangThai = "status-empty";
                    }
                    else
                    {
                        trangThai = "Đang áp dụng";
                        lopTrangThai = "status-selling";
                    }

                    <tr>
                        <td>
                            <strong class="d-block">
                                @ma.MaCode
                            </strong>

                            <span class="product-meta">
                                @ma.TenKhuyenMai
                            </span>
                        </td>

                        <td>
                            @if (ma.LoaiGiam == LoaiGiamGia.PhanTram)
                            {
                                <span class="product-price">
                                    @ma.GiaTriGiam.ToString("0.##", vi)%
                                </span>

                                if (ma.GiamToiDa.HasValue)
                                {
                                    <span class="product-meta d-block mt-1">
                                        Tối đa
                                        @ma.GiamToiDa.Value.ToString("N0", vi) đ
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="product-price">
                                    @ma.GiaTriGiam.ToString("N0", vi) đ
                                </span>
                            }
                        </td>

                        <td class="text-nowrap">
                            @ma.DonToiThieu.ToString("N0", vi) đ
                        </td>

                        <td class="text-nowrap">
                            <span class="d-block">
                                Từ @ma.NgayBatDau.ToString("dd/MM/yyyy")
                            </span>

                            <span class="product-meta">
                                Đến @ma.NgayKetThuc.ToString("dd/MM/yyyy")
                            </span>
                        </td>

                        <td class="text-nowrap">
                            @ma.SoLuotDaDung.ToString("N0", vi)
                            /
                            @ma.SoLuotToiDa.ToString("N0", vi)
                        </td>

                        <td>
                            <span class="status-pill @lopTrangThai">
                                @trangThai
                            </span>
                        </td>

                        <td>
                            <div class="d-flex justify-content-end flex-wrap gap-2">
                                <a href="@Url.Action("Sua", "KhuyenMai", new
                                        {
                                            area = "Admin",
                                            id = ma.MaGiamGia1
                                        })"
                                   class="btn btn-outline-primary btn-sm"
                                   aria-label="@("Sửa mã " + ma.MaCode)">
                                    <i class="bi bi-pencil-square"
                                       aria-hidden="true"></i>
                                    Sửa
                                </a>

                                @using (Html.BeginForm(
                                    "BatTat",
                                    "KhuyenMai",
                                    new { area = "Admin" },
                                    FormMethod.Post,
                                    new { @class = "m-0" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@ma.MaGiamGia1" />

                                    <button type="submit"
                                            class="btn btn-outline-secondary btn-sm"
                                            aria-label="@((ma.HoatDong ? "Tắt mã " : "Bật mã ") + ma.MaCode)">
                                        @(ma.HoatDong ? "Tắt mã" : "Bật mã")
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="product-panel-footer">
        <span>
            Hiển thị @Model.Count / @tongSo mã giảm giá
            · Trang @trang / @tongTrang
        </span>

        <nav aria-label="Phân trang mã giảm giá">
            <ul class="pagination pagination-sm">
                @NutTrang(1, "«", "Trang đầu", trang == 1, tuKhoa)

                @NutTrang(
                    trang - 1,
                    "‹",
                    "Trang trước",
                    trang == 1,
                    tuKhoa)

                @for (int i = batDau; i <= ketThuc; i++)
                {
                    <li class="page-item @(i == trang ? "active" : "")">
                        @if (i == trang)
                        {
                            <span class="page-link" aria-current="page">
                                @i
                            </span>
                        }
                        else
                        {
                            <a class="page-link"
                               aria-label="@("Trang " + i)"
                               href="@Url.Action("Index", "KhuyenMai", new
                                    {
                                        area = "Admin",
                                        tuKhoa = tuKhoa,
                                        trang = i
                                    })">
                                @i
                            </a>
                        }
                    </li>
                }

                @NutTrang(
                    trang + 1,
                    "›",
                    "Trang sau",
                    trang == tongTrang,
                    tuKhoa)

                @NutTrang(
                    tongTrang,
                    "»",
                    "Trang cuối",
                    trang == tongTrang,
                    tuKhoa)
            </ul>
        </nav>
    </div>
</div>