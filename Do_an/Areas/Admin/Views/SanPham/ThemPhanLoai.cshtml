@model Do_an.ViewModels.ThemPhanLoaiViewModel

@{
    ViewBag.Title = "Thêm màu / kích cỡ";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Thêm màu / kích cỡ</h1>
        <p class="text-secondary mb-0">@Model.TenSanPham</p>
    </div>

    <a href="@Url.Action("ChiTiet", new { id = Model.MaSanPham })"
       class="btn btn-outline-secondary">
        Quay lại
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm(
            "ThemPhanLoai",
            "SanPham",
            new { area = "Admin" },
            FormMethod.Post,
            new { @class = "row g-3" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaSanPham)

            <div class="col-12">
                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger" })

                <p class="text-secondary mb-0">
                    Mỗi tổ hợp màu và kích cỡ chỉ được tạo một lần.
                    Nếu sản phẩm không có màu hoặc kích cỡ,
                    để trống ô tương ứng.
                </p>
            </div>

            <div class="col-md-6">
                @Html.LabelFor(
                    m => m.MauSac,
                    new { @class = "form-label" })

                @Html.TextBoxFor(
                    m => m.MauSac,
                    new
                    {
                        @class = "form-control",
                        maxlength = "50",
                        placeholder = "Ví dụ: Đen, Xanh dương"
                    })

                @Html.ValidationMessageFor(
                    m => m.MauSac,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(
                    m => m.KichThuoc,
                    new { @class = "form-label" })

                @Html.TextBoxFor(
                    m => m.KichThuoc,
                    new
                    {
                        @class = "form-control",
                        maxlength = "30",
                        placeholder = "Ví dụ: M, 40, 750 ml, 2 m"
                    })

                @Html.ValidationMessageFor(
                    m => m.KichThuoc,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label for="GiaBan" class="form-label">
                    Giá gốc
                </label>

                <div class="input-group">
                    @Html.TextBoxFor(
                        m => m.GiaBan,
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "0",
                            step = "0.01",
                            required = "required"
                        })

                    <span class="input-group-text">đ</span>
                </div>

                @Html.ValidationMessageFor(
                    m => m.GiaBan,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label for="SoLuongTon" class="form-label">
                    Số lượng ban đầu
                </label>

                @Html.TextBoxFor(
                    m => m.SoLuongTon,
                    new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "0",
                        max = "2147483647",
                        step = "1",
                        required = "required"
                    })

                @Html.ValidationMessageFor(
                    m => m.SoLuongTon,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-12">
                <p class="text-secondary small mb-0">
                    SKU được tạo tự động.
                    Giá sau giảm áp dụng theo mức giảm của sản phẩm.
                </p>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Thêm loại này
                </button>

                <a href="@Url.Action("ChiTiet", new { id = Model.MaSanPham })"
                   class="btn btn-outline-secondary">
                    Hủy
                </a>
            </div>
        }
    </div>
</div>