@model Do_an.Models.SanPham
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Chi tiết sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var homNay = DateTime.Now;

    bool hangMoi = Model.NgayTao <= homNay
        && Model.NgayTao > homNay.AddDays(-30);

    var danhSachAnh = Model.HinhAnhSanPhams
        .OrderByDescending(a => a.AnhDaiDien)
        .ThenBy(a => a.ThuTu)
        .ThenBy(a => a.MaHinhAnh)
        .ToList();

    var danhSachPhanLoai = Model.BienTheSanPhams
        .OrderBy(bt => bt.KichThuoc)
        .ThenBy(bt => bt.MauSac)
        .ToList();

    long tongTon = danhSachPhanLoai
        .Sum(bt => (long)bt.SoLuongTon);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Chi tiết sản phẩm</h1>
        <p class="text-secondary mb-0">
            Mã sản phẩm: #@Model.MaSanPham
        </p>
    </div>

    <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })"
       class="btn btn-outline-secondary">
        Về danh sách
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Hình ảnh</h2>

                @if (danhSachAnh.Any())
                {
                    var anhChinh = danhSachAnh.First();

                    <div class="ratio ratio-1x1 rounded overflow-hidden bg-light">
                        <img src="@Url.Content(anhChinh.DuongDanAnh)"
                             alt="@Model.TenSanPham"
                             class="w-100 h-100"
                             style="object-fit: contain;" />
                    </div>

                    if (danhSachAnh.Count > 1)
                    {
                        <div class="row g-2 mt-2">
                            @foreach (var anh in danhSachAnh.Skip(1))
                            {
                                <div class="col-4">
                                    <a href="@Url.Content(anh.DuongDanAnh)"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        <div class="ratio ratio-1x1">
                                            <img src="@Url.Content(anh.DuongDanAnh)"
                                                 alt="@(anh.MoTaAnh ?? Model.TenSanPham)"
                                                 class="w-100 h-100 rounded border"
                                                 style="object-fit: contain;" />
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="bg-light rounded text-center text-secondary p-5">
                        Sản phẩm chưa có hình ảnh.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.DangBan)
                    {
                        <span class="badge bg-success">Đang bán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng bán</span>
                    }

                    @if (Model.PhanTramGiam > 0)
                    {
                        <span class="badge bg-danger">
                            Giảm @Model.PhanTramGiam%
                        </span>
                    }
                    else if (hangMoi)
                    {
                        <span class="badge bg-primary">Hàng mới</span>
                    }

                    @if (Model.NoiBat)
                    {
                        <span class="badge bg-warning text-dark">
                            Nổi bật
                        </span>
                    }
                </div>

                <h2 class="h4 mb-4">@Model.TenSanPham</h2>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Loại hàng</dt>
                    <dd class="col-sm-8">@Model.LoaiHang.TenLoaiHang</dd>

                    <dt class="col-sm-4">Thương hiệu</dt>
                    <dd class="col-sm-8">@Model.ThuongHieu.TenThuongHieu</dd>

                    <dt class="col-sm-4">Số phân loại</dt>
                    <dd class="col-sm-8">@danhSachPhanLoai.Count</dd>

                    <dt class="col-sm-4">Tổng tồn kho</dt>
                    <dd class="col-sm-8">
                        @tongTon.ToString("N0", vi)
                    </dd>

                    <dt class="col-sm-4">Ngày thêm</dt>
                    <dd class="col-sm-8">
                        @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4">Cập nhật gần nhất</dt>
                    <dd class="col-sm-8">
                        @(Model.NgayCapNhat.HasValue
                            ? Model.NgayCapNhat.Value.ToString("dd/MM/yyyy HH:mm")
                            : "Chưa cập nhật")
                    </dd>
                </dl>

                <hr />

                <h3 class="h6">Mô tả sản phẩm</h3>

                <p class="text-secondary mb-0"
                   style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả." : Model.MoTa)</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">Size / Màu và tồn kho</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Size</th>
                    <th scope="col">Màu</th>
                    <th scope="col">Giá gốc</th>
                    <th scope="col">Giá sau giảm</th>
                    <th scope="col" class="text-center">Tồn kho</th>
                    <th scope="col">Tình trạng kho</th>
                    <th scope="col">Kinh doanh</th>
                </tr>
            </thead>

            <tbody>
                @if (!danhSachPhanLoai.Any())
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-secondary py-4">
                            Chưa có phân loại size / màu.
                        </td>
                    </tr>
                }

                @foreach (var item in danhSachPhanLoai)
                {
                    decimal giaSauGiam = Math.Round(
                        item.GiaBan * (100 - Model.PhanTramGiam) / 100m,
                        0,
                        MidpointRounding.AwayFromZero
                    );

                    <tr>
                        <td class="text-nowrap">@item.SKU</td>
                        <td>@item.KichThuoc</td>
                        <td>@item.MauSac</td>

                        <td class="text-nowrap">
                            @item.GiaBan.ToString("N0", vi) đ
                        </td>

                        <td class="text-nowrap fw-semibold text-primary">
                            @giaSauGiam.ToString("N0", vi) đ
                        </td>

                        <td class="text-center">
                            @item.SoLuongTon
                        </td>

                        <td class="text-nowrap">
                            @if (item.SoLuongTon == 0)
                            {
                                <span class="badge bg-danger">
                                    Hết hàng
                                </span>
                            }
                            else if (item.SoLuongTon <= 5)
                            {
                                <span class="badge bg-warning text-dark">
                                    Sắp hết hàng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Còn hàng
                                </span>
                            }
                        </td>

                        <td class="text-nowrap">
                            @if (Model.DangBan && item.DangBan)
                            {
                                <span class="text-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="text-secondary">Ngừng bán</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>