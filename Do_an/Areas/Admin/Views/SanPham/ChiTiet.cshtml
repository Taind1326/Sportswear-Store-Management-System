@model Do_an.Models.SanPham
@using System
@using System.Linq
@using System.Globalization
@using Do_an.Services

@{
    ViewBag.Title = "Chi tiết sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var danhSachAnh = Model.HinhAnhSanPhams
        .OrderByDescending(x => x.AnhDaiDien)
        .ThenBy(x => x.ThuTu)
        .ThenBy(x => x.MaHinhAnh)
        .ToList();

    var anhChinh = danhSachAnh.FirstOrDefault();

    var anhMacDinh = danhSachAnh.FirstOrDefault(x =>
        x.AnhDaiDien &&
        !string.IsNullOrWhiteSpace(x.DuongDanAnh))
        ?? danhSachAnh.FirstOrDefault(x =>
            string.IsNullOrWhiteSpace(x.MauSac) &&
            !string.IsNullOrWhiteSpace(x.DuongDanAnh));

    bool coAnh = anhChinh != null &&
        !string.IsNullOrWhiteSpace(anhChinh.DuongDanAnh);

    var danhSachPhanLoai = Model.BienTheSanPhams
        .OrderBy(x => x.MauSac)
        .ThenBy(x => x.KichThuoc)
        .ToList();

    long tongTon = danhSachPhanLoai
        .Sum(x => (long)x.SoLuongTon);

    var danhSachGia = danhSachPhanLoai
        .Where(x => x.DangBan)
        .Select(x => QuyTacSanPham.GiaSauGiam(
            x.GiaBan,
            Model.PhanTramGiam))
        .ToList();

    string giaHienThi = "Chưa có phân loại đang bán";

    if (danhSachGia.Any())
    {
        decimal giaThapNhat = danhSachGia.Min();
        decimal giaCaoNhat = danhSachGia.Max();

        giaHienThi = giaThapNhat == giaCaoNhat
            ? giaThapNhat.ToString("N0", vi) + " đ"
            : giaThapNhat.ToString("N0", vi)
                + " – "
                + giaCaoNhat.ToString("N0", vi)
                + " đ";
    }
}

<div class="product-page-heading">
    <div>
        <h1>Chi tiết sản phẩm</h1>
        <p>Thông tin và số lượng từng phân loại sản phẩm.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("BoSungHang", "SanPham", new
                 {
                     area = "Admin",
                     id = Model.MaSanPham
                 })"
           class="btn btn-primary px-3 py-2">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Bổ sung hàng
        </a>

        <a href="@Url.Action("Index", "XoaSanPham", new
                 {
                     area = "Admin",
                     id = Model.MaSanPham
                 })"
           class="btn btn-outline-danger px-3 py-2">
            <i class="bi bi-trash" aria-hidden="true"></i>
            Xóa / Ngừng bán
        </a>
    </div>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["ThanhCong"]
    </div>
}

<div class="product-panel mb-4">
    <div class="d-flex align-items-start flex-wrap gap-3">
        @if (coAnh)
        {
            <img src="@Url.Content(anhChinh.DuongDanAnh)"
                 alt="@Model.TenSanPham"
                 width="104"
                 height="104"
                 class="product-thumb admin-detail-image" />

            <span class="product-no-image admin-detail-image"
                  hidden
                  role="img"
                  aria-label="Chưa có ảnh sản phẩm">
                <i class="bi bi-image" aria-hidden="true"></i>
            </span>
        }
        else
        {
            <span class="product-no-image admin-detail-image"
                  role="img"
                  aria-label="Chưa có ảnh sản phẩm">
                <i class="bi bi-image" aria-hidden="true"></i>
            </span>
        }

        <div class="flex-grow-1 admin-detail-info">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="h5 fw-bold mb-2">
                        @Model.TenSanPham
                    </h2>

                    <p class="product-meta mb-2">
                        @Model.LoaiHang.TenLoaiHang
                        · @Model.ThuongHieu.TenThuongHieu
                        · Mã #@Model.MaSanPham
                    </p>
                </div>

                <a href="@Url.Action("Sua", "SanPham", new
                         {
                             area = "Admin",
                             id = Model.MaSanPham
                         })"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    Sửa thông tin
                </a>
            </div>

            <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                <span class="status-pill @(Model.DangBan
                    ? "status-selling"
                    : "status-stopped")">
                    @(Model.DangBan ? "Đang bán" : "Ngừng bán")
                </span>

                @if (Model.PhanTramGiam > 0)
                {
                    <span class="status-pill status-discount">
                        Giảm @Model.PhanTramGiam%
                    </span>
                }

                @if (Model.NoiBat)
                {
                    <span class="status-pill status-low">
                        Nổi bật
                    </span>
                }
            </div>

            <div class="product-price fs-4 mb-2">
                @giaHienThi
            </div>

            @if (danhSachGia.Any() && Model.PhanTramGiam > 0)
            {
                <p class="product-meta mb-0">
                    Giá đã áp dụng giảm @Model.PhanTramGiam%.
                </p>
            }
        </div>
    </div>

    <details class="admin-product-description mt-3">
        <summary>Mô tả sản phẩm</summary>

        <div class="mt-2 text-secondary admin-description-text">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả sản phẩm." : Model.MoTa)</div>
    </details>

    @if (danhSachAnh.Count > 1)
    {
        <details class="mt-3">
            <summary>Hình ảnh khác (@(danhSachAnh.Count - 1))</summary>

            <div class="d-flex flex-wrap gap-2 mt-3">
                @foreach (var anh in danhSachAnh.Skip(1))
                {
                    if (!string.IsNullOrWhiteSpace(anh.DuongDanAnh))
                    {
                        <a href="@Url.Content(anh.DuongDanAnh)"
                           target="_blank"
                           rel="noopener noreferrer">
                            <img src="@Url.Content(anh.DuongDanAnh)"
                                 alt="@(anh.MoTaAnh ?? Model.TenSanPham)"
                                 width="66"
                                 height="66"
                                 loading="lazy"
                                 class="product-thumb" />
                        </a>
                    }
                }
            </div>
        </details>
    }
</div>

<div class="product-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2 class="h5 fw-bold mb-1">
                Các phân loại sản phẩm
            </h2>

            <p class="product-meta mb-0">
                @danhSachPhanLoai.Count phân loại
            </p>
        </div>

        <a href="@Url.Action("ThemPhanLoai", "SanPham", new
                 {
                     area = "Admin",
                     id = Model.MaSanPham
                 })"
           class="btn btn-outline-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Thêm màu / kích cỡ
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover product-table">
            <thead>
                <tr>
                    <th scope="col">Màu</th>
                    <th scope="col">Kích cỡ / dung tích</th>
                    <th scope="col" class="text-end">Còn lại</th>
                    <th scope="col" class="text-end">
                        <span class="visually-hidden">Thao tác</span>
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (!danhSachPhanLoai.Any())
                {
                    <tr>
                        <td colspan="4"
                            class="text-center text-secondary py-4">
                            Chưa có phân loại.
                            Bấm “Thêm màu / kích cỡ” để tạo phân loại đầu tiên.
                        </td>
                    </tr>
                }

                @foreach (var item in danhSachPhanLoai)
                {
                    var anhPhanLoai = danhSachAnh.FirstOrDefault(x =>
                        !string.IsNullOrWhiteSpace(x.MauSac) &&
                        !string.IsNullOrWhiteSpace(x.DuongDanAnh) &&
                        string.Equals(
                            x.MauSac,
                            item.MauSac,
                            StringComparison.OrdinalIgnoreCase))
                        ?? anhMacDinh;

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (anhPhanLoai != null)
                                {
                                    <img src="@Url.Content(anhPhanLoai.DuongDanAnh)"
                                         alt=""
                                         width="40"
                                         height="40"
                                         class="rounded"
                                         style="object-fit: cover;"
                                         loading="lazy" />
                                }

                                <span class="fw-medium">
                                    @item.MauSac
                                </span>
                            </div>

                            @if (!item.DangBan)
                            {
                                <div class="product-meta mt-1">
                                    Ngừng bán
                                </div>
                            }
                        </td>

                        <td>@item.KichThuoc</td>

                        <td class="text-end">
                            <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
                                @if (item.SoLuongTon == 0)
                                {
                                    <span class="status-pill status-empty">
                                        Hết hàng
                                    </span>
                                }
                                else if (item.SoLuongTon <= 5)
                                {
                                    <span class="status-pill status-low">
                                        Sắp hết
                                    </span>
                                }

                                <strong>
                                    @item.SoLuongTon.ToString("N0", vi)
                                </strong>
                            </div>
                        </td>

                        <td class="text-end">
                            <a href="@Url.Action("SuaPhanLoai", "SanPham", new
                                     {
                                         area = "Admin",
                                         id = item.MaBienThe
                                     })"
                               class="btn btn-outline-primary btn-sm"
                               aria-label="@("Sửa phân loại " + item.MauSac + " / " + item.KichThuoc)">
                                Sửa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="product-panel-footer">
        <div>
            <div class="fw-semibold">Tổng tồn kho</div>
            <small>Tự động cộng từ tất cả phân loại.</small>
        </div>

        <strong class="product-price fs-3">
            @tongTon.ToString("N0", vi)
        </strong>
    </div>
</div>

<div class="mt-4">
    <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        Về danh sách sản phẩm
    </a>
</div>