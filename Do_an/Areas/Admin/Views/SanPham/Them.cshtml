@model Do_an.ViewModels.ThemSanPhamViewModel

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h1 class="h3 mb-0">Thêm sản phẩm</h1>

        <a href="@Url.Action("Index")"
           class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @using (Html.BeginForm(
        "Them",
        "SanPham",
        new { area = "Admin" },
        FormMethod.Post,
        new { id = "formSanPham", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
            false,
            "",
            new { @class = "text-danger mb-3" })

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-4">Thông tin sản phẩm</h2>

                <div class="mb-3">
                    @Html.LabelFor(
                        m => m.TenSanPham,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(
                        m => m.TenSanPham,
                        new
                        {
                            @class = "form-control",
                            maxlength = "200",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(m => m.TenSanPham)
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(
                            m => m.MaLoaiHang,
                            new { @class = "form-label" })

                        @Html.DropDownList(
                            "MaLoaiHang",
                            null,
                            "-- Chọn loại hàng --",
                            new
                            {
                                @class = "form-select",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(m => m.MaLoaiHang)
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(
                            m => m.MaThuongHieu,
                            new { @class = "form-label" })

                        @Html.DropDownList(
                            "MaThuongHieu",
                            null,
                            "-- Chọn thương hiệu --",
                            new
                            {
                                @class = "form-select",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(m => m.MaThuongHieu)
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(
                        m => m.MoTa,
                        new { @class = "form-label" })

                    @Html.TextAreaFor(
                        m => m.MoTa,
                        new
                        {
                            @class = "form-control",
                            rows = "4"
                        })
                </div>

                <div class="form-check">
                    @Html.CheckBoxFor(
                        m => m.NoiBat,
                        new { @class = "form-check-input" })

                    @Html.LabelFor(
                        m => m.NoiBat,
                        new { @class = "form-check-label" })
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <h2 class="h5">Màu / Kích cỡ và tồn kho</h2>

                        <p class="text-muted mb-0">
                            Mỗi tổ hợp màu và kích cỡ có giá, tồn kho riêng.
                            Không có màu hoặc kích cỡ thì để trống ô tương ứng.
                        </p>
                    </div>

                    <button type="button"
                            id="themDong"
                            class="btn btn-outline-primary">
                        Thêm phân loại
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Màu</th>
                                <th scope="col">Kích cỡ / Dung tích</th>
                                <th scope="col">Giá gốc (đ)</th>
                                <th scope="col">Số lượng ban đầu</th>
                                <th scope="col">
                                    <span class="visually-hidden">
                                        Thao tác
                                    </span>
                                </th>
                            </tr>
                        </thead>

                        <tbody id="danhSachPhanLoai">
                            @for (int i = 0; i < Model.PhanLoai.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Html.TextBoxFor(
                                            m => m.PhanLoai[i].MauSac,
                                            new
                                            {
                                                @class = "form-control",
                                                data_field = "MauSac",
                                                list = "goiYMau",
                                                maxlength = "50",
                                                placeholder = "Ví dụ: Đen",
                                                aria_label = "Màu"
                                            })
                                    </td>

                                    <td>
                                        @Html.TextBoxFor(
                                            m => m.PhanLoai[i].KichThuoc,
                                            new
                                            {
                                                @class = "form-control",
                                                data_field = "KichThuoc",
                                                list = "goiYSize",
                                                maxlength = "30",
                                                placeholder = "M, 40, 750ml...",
                                                aria_label = "Kích cỡ hoặc dung tích"
                                            })
                                    </td>

                                    <td>
                                        @Html.TextBoxFor(
                                            m => m.PhanLoai[i].GiaBan,
                                            "{0:0.##}",
                                            new
                                            {
                                                @class = "form-control",
                                                data_field = "GiaBan",
                                                type = "number",
                                                min = "0",
                                                step = "0.01",
                                                required = "required",
                                                aria_label = "Giá gốc"
                                            })
                                    </td>

                                    <td>
                                        @Html.TextBoxFor(
                                            m => m.PhanLoai[i].SoLuongTon,
                                            new
                                            {
                                                @class = "form-control",
                                                data_field = "SoLuongTon",
                                                type = "number",
                                                min = "0",
                                                step = "1",
                                                required = "required",
                                                aria_label = "Số lượng ban đầu"
                                            })
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-danger xoa-dong">
                                            Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="small text-muted mb-0">
                    Có thể chọn gợi ý hoặc nhập màu, kích cỡ khác.
                    Mã phân loại được tạo tự động khi lưu.
                </p>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Lưu sản phẩm
            </button>

            <a href="@Url.Action("Index")"
               class="btn btn-outline-secondary">
                Hủy
            </a>
        </div>
    }
</div>

<datalist id="goiYMau">
    <option value="Đen"></option>
    <option value="Trắng"></option>
    <option value="Xanh"></option>
    <option value="Đỏ"></option>
    <option value="Vàng"></option>
    <option value="Xám"></option>
    <option value="Mặc định"></option>
</datalist>

<datalist id="goiYSize">
    <option value="S"></option>
    <option value="M"></option>
    <option value="L"></option>
    <option value="XL"></option>
    <option value="XXL"></option>
    <option value="XXXL"></option>

    @for (int size = 36; size <= 45; size++)
    {
        <option value="@size"></option>
    }

    <option value="500ml"></option>
    <option value="750ml"></option>
    <option value="1L"></option>
    <option value="Mặc định"></option>
</datalist>

<template id="mauDong">
    <tr>
        <td>
            <input type="text"
                   class="form-control"
                   data-field="MauSac"
                   list="goiYMau"
                   maxlength="50"
                   placeholder="Ví dụ: Đen"
                   aria-label="Màu" />
        </td>

        <td>
            <input type="text"
                   class="form-control"
                   data-field="KichThuoc"
                   list="goiYSize"
                   maxlength="30"
                   placeholder="M, 40, 750ml..."
                   aria-label="Kích cỡ hoặc dung tích" />
        </td>

        <td>
            <input type="number"
                   class="form-control"
                   data-field="GiaBan"
                   min="0"
                   step="0.01"
                   aria-label="Giá gốc"
                   required />
        </td>

        <td>
            <input type="number"
                   class="form-control"
                   data-field="SoLuongTon"
                   min="0"
                   step="1"
                   value="0"
                   aria-label="Số lượng ban đầu"
                   required />
        </td>

        <td>
            <button type="button"
                    class="btn btn-outline-danger xoa-dong">
                Xóa
            </button>
        </td>
    </tr>
</template>

@section scripts {
    <script src="@Url.Content("~/Scripts/admin/sanpham-them.js")"></script>
}