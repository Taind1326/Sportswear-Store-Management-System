@model Do_an.ViewModels.SuaPhanLoaiViewModel

@{
    ViewBag.Title = "Sửa phân loại sản phẩm";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Sửa phân loại sản phẩm</h1>
            <p class="text-secondary mb-0">@Model.TenSanPham</p>
        </div>

        <a href="@Url.Action("ChiTiet", new { id = Model.MaSanPham })"
           class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @using (Html.BeginForm(
        "SuaPhanLoai",
        "SanPham",
        new { area = "Admin" },
        FormMethod.Post,
        new
        {
            @class = "card border-0 shadow-sm",
            novalidate = "novalidate"
        }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaBienThe)

        <div class="card-body p-4">
            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger mb-3" })

            <div class="mb-4">
                <span class="text-secondary">SKU:</span>
                <strong>@Model.SKU</strong>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(
                        m => m.MauSac,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(
                        m => m.MauSac,
                        new
                        {
                            @class = "form-control",
                            maxlength = "50",
                            placeholder = "Ví dụ: Đen, Xanh dương",

                            data_msg_maxlength =
                                "Màu không được vượt quá 50 ký tự."
                        })

                    @Html.ValidationMessageFor(
                        m => m.MauSac,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(
                        m => m.KichThuoc,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(
                        m => m.KichThuoc,
                        new
                        {
                            @class = "form-control",
                            maxlength = "30",
                            placeholder = "Ví dụ: M, 40, 750ml",

                            data_msg_maxlength =
                                "Kích cỡ không được vượt quá 30 ký tự."
                        })

                    @Html.ValidationMessageFor(
                        m => m.KichThuoc,
                        "",
                        new { @class = "text-danger" })
                </div>
            </div>

            <p class="text-secondary small">
                Không có màu hoặc kích cỡ thì để trống ô tương ứng.
                Phân loại đã có đơn hàng chỉ được sửa giá và trạng thái bán.
            </p>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(
                        m => m.GiaBan,
                        new { @class = "form-label" })

                    <div class="input-group">
                        @Html.TextBoxFor(
                            m => m.GiaBan,
                            "{0:0.##}",
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                max = "9999999999999999.99",
                                step = "0.01",
                                required = "required",

                                data_val = "true",

                                data_val_required =
                                    "Vui lòng nhập giá gốc.",

                                data_val_number =
                                    "Vui lòng nhập giá gốc bằng số hợp lệ.",

                                data_msg_required =
                                    "Vui lòng nhập giá gốc.",

                                data_msg_number =
                                    "Vui lòng nhập giá gốc bằng số hợp lệ.",

                                data_msg_min =
                                    "Giá gốc không được nhỏ hơn 0.",

                                data_msg_max =
                                    "Giá gốc vượt quá giới hạn cho phép.",

                                data_msg_step =
                                    "Giá gốc chỉ được có tối đa 2 chữ số thập phân."
                            })

                        <span class="input-group-text">đ</span>
                    </div>

                    @Html.ValidationMessageFor(
                        m => m.GiaBan,
                        "",
                        new { @class = "text-danger" })

                    <div class="form-text">
                        Đây là giá trước giảm.
                        Mức giảm áp dụng theo thông tin sản phẩm.
                    </div>
                </div>
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(
                    m => m.DangBan,
                    new { @class = "form-check-input" })

                @Html.LabelFor(
                    m => m.DangBan,
                    new { @class = "form-check-label" })
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a href="@Url.Action("ChiTiet", new { id = Model.MaSanPham })"
                   class="btn btn-outline-secondary">
                    Hủy
                </a>
            </div>
        </div>
    }
</div>