@model IEnumerable<Do_an.Models.SanPham>
@using System
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Quản lý sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var homNay = DateTime.Now;
    var danhSach = Model.ToList();

    string tuKhoa = ViewBag.TuKhoa;
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
    int tongSanPham = ViewBag.TongSanPham;

    int batDau = Math.Max(1, trang - 2);
    int ketThuc = Math.Min(tongTrang, trang + 2);
}

<div class="product-page-heading">
    <div>
        <h1>Quản lý sản phẩm</h1>
        <p>Theo dõi sản phẩm, phân loại và tồn kho</p>
    </div>

    <a href="@Url.Action("Them", "SanPham", new { area = "Admin" })"
       class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        Thêm sản phẩm
    </a>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["ThanhCong"]
    </div>
}

<div class="product-panel">
    @using (Html.BeginForm(
        "Index",
        "SanPham",
        new { area = "Admin" },
        FormMethod.Get,
        new { @class = "product-search" }))
    {
        <div class="product-search-box">
            <label for="tuKhoa" class="visually-hidden">
                Tìm theo tên sản phẩm hoặc SKU
            </label>

            <i class="bi bi-search" aria-hidden="true"></i>

            <input type="search"
                   id="tuKhoa"
                   name="tuKhoa"
                   value="@tuKhoa"
                   maxlength="200"
                   class="form-control"
                   placeholder="Tìm theo tên sản phẩm hoặc SKU..." />
        </div>

        <button type="submit" class="btn btn-primary px-3">
            Tìm kiếm
        </button>

        <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })"
           class="btn btn-outline-secondary px-3">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            Đặt lại
        </a>
    }

    <div class="table-responsive">
        <table class="table table-hover product-table">
            <thead>
                <tr>
                    <th scope="col">Mã</th>
                    <th scope="col">Sản phẩm</th>
                    <th scope="col">Giá bán từ</th>
                    <th scope="col" class="text-center">Tồn kho</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (!danhSach.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-secondary py-5">
                            Không tìm thấy sản phẩm phù hợp.
                        </td>
                    </tr>
                }

                @foreach (var item in danhSach)
                {
                    var anh = item.HinhAnhSanPhams
                        .OrderByDescending(x => x.AnhDaiDien)
                        .ThenBy(x => x.ThuTu)
                        .ThenBy(x => x.MaHinhAnh)
                        .FirstOrDefault();

                    bool coAnh = anh != null &&
                        !string.IsNullOrWhiteSpace(anh.DuongDanAnh);

                    var phanLoaiDangBan = item.BienTheSanPhams
                        .Where(x => x.DangBan)
                        .ToList();

                    decimal? giaGoc = phanLoaiDangBan.Any()
                        ? phanLoaiDangBan.Min(x => x.GiaBan)
                        : (decimal?)null;

                    decimal? giaSauGiam = giaGoc.HasValue
                        ? Math.Round(
                            giaGoc.Value *
                            (100 - item.PhanTramGiam) / 100m,
                            0,
                            MidpointRounding.AwayFromZero)
                        : (decimal?)null;

                    long tongTon = item.BienTheSanPhams
                        .Sum(x => (long)x.SoLuongTon);

                    bool hangMoi = item.NgayTao <= homNay &&
                        item.NgayTao > homNay.AddDays(-30);

                    string linkChiTiet = Url.Action(
                        "ChiTiet",
                        "SanPham",
                        new
                        {
                            area = "Admin",
                            id = item.MaSanPham
                        });

                    <tr>
                        <td class="text-secondary">
                            #@item.MaSanPham
                        </td>

                        <td>
                            <div class="product-cell">
                                @if (coAnh)
                                {
                                    <img src="@Url.Content(anh.DuongDanAnh)"
                                         alt="@item.TenSanPham"
                                         width="66"
                                         height="66"
                                         loading="lazy"
                                         class="product-thumb" />

                                    <span class="product-no-image"
                                          hidden
                                          role="img"
                                          aria-label="Chưa có ảnh sản phẩm">
                                        <i class="bi bi-image"
                                           aria-hidden="true"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="product-no-image"
                                          role="img"
                                          aria-label="Chưa có ảnh sản phẩm">
                                        <i class="bi bi-image"
                                           aria-hidden="true"></i>
                                    </span>
                                }

                                <div>
                                    <a href="@linkChiTiet"
                                       class="product-name">
                                        @item.TenSanPham
                                    </a>

                                    <div class="product-meta">
                                        @item.BienTheSanPhams.Count phân loại
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>
                            @if (giaSauGiam.HasValue)
                            {
                                <div class="product-price">
                                    @giaSauGiam.Value.ToString("N0", vi) đ
                                </div>

                                if (item.PhanTramGiam > 0)
                                {
                                    <small class="product-old-price">
                                        @giaGoc.Value.ToString("N0", vi) đ
                                    </small>

                                    <span class="status-pill status-discount">
                                        Giảm @item.PhanTramGiam%
                                    </span>
                                }
                                else if (hangMoi)
                                {
                                    <span class="status-pill status-new mt-1">
                                        Hàng mới
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="product-meta">
                                    Chưa có giá đang bán
                                </span>
                            }
                        </td>

                        <td>
                            <div class="product-stock">
                                <span>@tongTon.ToString("N0", vi)</span>

                                @if (tongTon == 0)
                                {
                                    <span class="status-pill status-empty">
                                        Hết hàng
                                    </span>
                                }
                                else if (tongTon <= 5)
                                {
                                    <span class="status-pill status-low">
                                        Sắp hết
                                    </span>
                                }
                            </div>
                        </td>

                        <td>
                            @if (item.DangBan)
                            {
                                <span class="status-pill status-selling">
                                    Đang bán
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-stopped">
                                    Ngừng bán
                                </span>
                            }
                        </td>

                        <td class="text-end text-nowrap">
                            <a href="@linkChiTiet"
                               class="btn btn-outline-primary btn-sm"
                               aria-label="@("Xem chi tiết " + item.TenSanPham)">
                                Xem chi tiết
                                <i class="bi bi-chevron-right"
                                   aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="product-panel-footer">
        <span>
            Hiển thị @danhSach.Count / @tongSanPham sản phẩm
        </span>

        <nav aria-label="Phân trang sản phẩm">
            <ul class="pagination pagination-sm">
                @if (trang > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           aria-label="Trang trước"
                           href="@Url.Action("Index", new
                                {
                                    area = "Admin",
                                    tuKhoa = tuKhoa,
                                    trang = trang - 1
                                })">
                            <i class="bi bi-chevron-left"
                               aria-hidden="true"></i>
                        </a>
                    </li>
                }

                @for (int i = batDau; i <= ketThuc; i++)
                {
                    <li class="page-item @(i == trang ? "active" : "")">
                        @if (i == trang)
                        {
                            <span class="page-link" aria-current="page">
                                @i
                            </span>
                        }
                        else
                        {
                            <a class="page-link"
                               href="@Url.Action("Index", new
                                    {
                                        area = "Admin",
                                        tuKhoa = tuKhoa,
                                        trang = i
                                    })">
                                @i
                            </a>
                        }
                    </li>
                }

                @if (trang < tongTrang)
                {
                    <li class="page-item">
                        <a class="page-link"
                           aria-label="Trang sau"
                           href="@Url.Action("Index", new
                                {
                                    area = "Admin",
                                    tuKhoa = tuKhoa,
                                    trang = trang + 1
                                })">
                            <i class="bi bi-chevron-right"
                               aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>