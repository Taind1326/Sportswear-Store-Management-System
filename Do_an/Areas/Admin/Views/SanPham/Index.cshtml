@model IEnumerable<Do_an.Models.SanPham>
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Quản lý sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var homNay = DateTime.Now;

    string tuKhoa = ViewBag.TuKhoa;
    int trang = ViewBag.Trang;
    int tongTrang = ViewBag.TongTrang;
    int tongSanPham = ViewBag.TongSanPham;

    int batDau = Math.Max(1, trang - 2);
    int ketThuc = Math.Min(tongTrang, trang + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Quản lý sản phẩm</h1>
        <p class="text-secondary mb-0">
            Tìm thấy @tongSanPham sản phẩm
        </p>
    </div>
</div>

@using (Html.BeginForm("Index", "SanPham",
    new { area = "Admin" }, FormMethod.Get,
    new { @class = "row g-2 mb-4" }))
{
    <div class="col-12 col-md-8 col-lg-6">
        <label for="tuKhoa" class="visually-hidden">
            Tìm sản phẩm
        </label>

        <input type="search"
               id="tuKhoa"
               name="tuKhoa"
               value="@tuKhoa"
               maxlength="200"
               class="form-control"
               placeholder="Nhập tên sản phẩm hoặc SKU..." />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>
    </div>

    <div class="col-auto">
        <a href="@Url.Action("Index", new { area = "Admin" })"
           class="btn btn-outline-secondary">
            Đặt lại
        </a>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã</th>
                    <th scope="col">Sản phẩm</th>
                    <th scope="col">Phân loại</th>
                    <th scope="col">Giá từ</th>
                    <th scope="col" class="text-center">Tồn kho</th>
                    <th scope="col">Nhãn</th>
                    <th scope="col">Kinh doanh</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-secondary py-5">
                            Không tìm thấy sản phẩm phù hợp.
                        </td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    var anh = item.HinhAnhSanPhams
                        .OrderByDescending(a => a.AnhDaiDien)
                        .ThenBy(a => a.ThuTu)
                        .ThenBy(a => a.MaHinhAnh)
                        .FirstOrDefault();

                    var bienTheDangBan = item.BienTheSanPhams
                        .Where(bt => bt.DangBan)
                        .ToList();

                    decimal? giaGoc = bienTheDangBan.Any()
                        ? bienTheDangBan.Min(bt => bt.GiaBan)
                        : (decimal?)null;

                    decimal? giaSauGiam = giaGoc.HasValue
                        ? Math.Round(
                            giaGoc.Value * (100 - item.PhanTramGiam) / 100m,
                            0,
                            MidpointRounding.AwayFromZero
                        )
                        : (decimal?)null;

                    long tongTon = item.BienTheSanPhams
                        .Sum(bt => (long)bt.SoLuongTon);

                    bool hangMoi = item.NgayTao <= homNay
                        && item.NgayTao > homNay.AddDays(-30);

                    <tr>
                        <td class="text-secondary">
                            #@item.MaSanPham
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (anh != null
                                    && !string.IsNullOrWhiteSpace(anh.DuongDanAnh))
                                {
                                    <img src="@Url.Content(anh.DuongDanAnh)"
                                         alt="@item.TenSanPham"
                                         width="56"
                                         height="56"
                                         class="rounded border"
                                         style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-secondary small">
                                        Chưa có ảnh
                                    </span>
                                }

                                <div>
                                    <div class="fw-semibold">
                                        @item.TenSanPham
                                    </div>

                                    <small class="text-secondary">
                                        @item.BienTheSanPhams.Count biến thể
                                    </small>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div>@item.LoaiHang.TenLoaiHang</div>
                            <small class="text-secondary">
                                @item.ThuongHieu.TenThuongHieu
                            </small>
                        </td>

                        <td class="text-nowrap">
                            @if (giaSauGiam.HasValue)
                            {
                                <div class="fw-semibold text-primary">
                                    @giaSauGiam.Value.ToString("N0", vi) đ
                                </div>

                                if (item.PhanTramGiam > 0)
                                {
                                    <small class="text-secondary text-decoration-line-through">
                                        @giaGoc.Value.ToString("N0", vi) đ
                                    </small>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">
                                    Chưa có giá đang bán
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @tongTon.ToString("N0", vi)
                        </td>

                        <td class="text-nowrap">
                            @if (item.PhanTramGiam > 0)
                            {
                                <span class="badge bg-danger">
                                    Giảm @item.PhanTramGiam%
                                </span>
                            }
                            else if (hangMoi)
                            {
                                <span class="badge bg-primary">
                                    Hàng mới
                                </span>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>

                        <td class="text-nowrap">
                            @if (item.DangBan)
                            {
                                <span class="badge bg-success">
                                    Đang bán
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Ngừng bán
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (tongTrang > 1)
{
    <nav class="mt-4" aria-label="Phân trang sản phẩm">
        <ul class="pagination justify-content-center flex-wrap">
            @if (trang > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           area = "Admin",
                           tuKhoa = tuKhoa,
                           trang = trang - 1
                       })">
                        Trước
                    </a>
                </li>
            }

            @for (int i = batDau; i <= ketThuc; i++)
            {
                <li class="page-item @(i == trang ? "active" : "")">
                    @if (i == trang)
                    {
                        <span class="page-link" aria-current="page">@i</span>
                    }
                    else
                    {
                        <a class="page-link"
                           href="@Url.Action("Index", new {
                               area = "Admin",
                               tuKhoa = tuKhoa,
                               trang = i
                           })">
                            @i
                        </a>
                    }
                </li>
            }

            @if (trang < tongTrang)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           area = "Admin",
                           tuKhoa = tuKhoa,
                           trang = trang + 1
                       })">
                        Sau
                    </a>
                </li>
            }
        </ul>
    </nav>
}